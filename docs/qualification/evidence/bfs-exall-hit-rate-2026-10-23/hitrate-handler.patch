@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+/* Hit-rate counter of a debug build (BFS_HITRATE), see the section
+ * "Hit-rate measurement" of docs/plans/bfs-exall-result-cache-v1.md. The
+ * handler counts the starts of ExAll and ExNext passes over a directory and
+ * the entries they return, by what a result cache could have served. This
+ * header is shared by the handler and the tools that read the counters. */
+#ifndef BFS_HITRATE_H
+#define BFS_HITRATE_H
+
+#include <stdint.h>
+
+#define BFS_ACTION_HITRATE_READ  3020 /* arg1: report buffer, arg2: its size */
+#define BFS_ACTION_HITRATE_RESET 3021 /* clears the counters and the table */
+
+#define BFS_HITRATE_MAGIC 0x48495452u /* "HITR" */
+#define BFS_HITRATE_VERSION 1u
+
+enum { HR_KIND_EXALL = 0, HR_KIND_EXNEXT = 1, HR_KINDS = 2 };
+/* The validity test: the tree stamps of the candidate, or the packet counter
+ * of the bound. */
+enum { HR_TEST_STAMPS = 0, HR_TEST_COUNTER = 1, HR_TESTS = 2 };
+/* The record a start is compared with: the latest complete pass of its own
+ * kind, or the latest complete pass of either kind. */
+enum { HR_SCOPE_KIND = 0, HR_SCOPE_ANY = 1, HR_SCOPES = 2 };
+enum {
+    HR_CLASS_NEW = 0,        /* A: no complete pass of the directory yet */
+    HR_CLASS_SAME_LOCK = 1,  /* B: unchanged, same lock */
+    HR_CLASS_OTHER_LOCK = 2, /* C: unchanged, another lock */
+    HR_CLASS_CHANGED = 3,    /* D: the volume changed since */
+    HR_CLASSES = 4
+};
+
+typedef struct {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t size;
+    uint32_t starts[HR_KINDS][HR_TESTS][HR_SCOPES][HR_CLASSES];
+    uint32_t entries[HR_KINDS][HR_TESTS][HR_SCOPES][HR_CLASSES];
+    uint32_t calls[HR_KINDS];            /* ExAll calls, ExNext calls */
+    uint32_t entries_returned[HR_KINDS]; /* entries of all calls */
+    uint32_t passes_complete[HR_KINDS];
+    uint32_t passes_abandoned[HR_KINDS]; /* ended by a restart or an UnLock */
+    uint32_t passes_changed[HR_KINDS];   /* complete, volume changed during it */
+    uint32_t orphan_entries[HR_KINDS];   /* entries of calls without a counted start */
+    uint32_t pattern_starts;             /* ExAll starts with a pattern */
+    uint32_t evictions;                  /* directories dropped from the table */
+    uint32_t directories;                /* directories in the table */
+    uint32_t volume_changes;             /* the packet counter */
+} bfs_hitrate_report_t;
+
+#endif
