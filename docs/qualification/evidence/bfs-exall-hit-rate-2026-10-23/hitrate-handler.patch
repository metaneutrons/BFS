+/* ── Hit-rate counter ───────────────────────────────────────── */
+
+/* The packets that can change the volume, as in the result cache bound: the
+ * ones a snapshot refuses, a close, a media change and the 64-bit resize. */
+static bool PacketMayChangeVolume(LONG type)
+{
+    if (SnapshotRejectsPacket(type)) return true;
+    switch (type) {
+    case ACTION_END:
+    case ACTION_INHIBIT:
+    case ACTION_DIE:
+    case BFS_ACTION_CHANGE_FILE_SIZE64:
+        return true;
+    default:
+        return false;
+    }
+}
+
+#define HR_DIRS 512
+
+/* What a complete pass left: the volume at its start and its lock, under each
+ * validity test. A pass during which the volume changed leaves nothing. */
+typedef struct {
+    bool valid;
+    hr_stamp_t stamp;
+    uint32_t counter;
+    const bfs_lock_t *lock; /* NULL once the lock is released */
+} hr_rec_t;
+
+typedef struct {
+    uint32_t ino;
+    hr_rec_t last[3][HR_TESTS]; /* latest ExAll pass, ExNext pass, either */
+} hr_dir_t;
+
+struct hr_state {
+    bfs_hitrate_report_t rep;
+    uint32_t used;
+    uint32_t next_evict;
+    hr_dir_t dirs[HR_DIRS];
+};
+
+/* A remount is another volume: the table of directories starts again. */
+static void HrForget(struct bfs_handler *h)
+{
+    if (h->hr) {
+        h->hr->used = 0;
+        h->hr->next_evict = 0;
+    }
+}
+
+static struct hr_state *HrGet(struct bfs_handler *h)
+{
+    if (!h->hr) h->hr = (struct hr_state *)AllocVec(sizeof(*h->hr), MEMF_ANY | MEMF_CLEAR);
+    return h->hr;
+}
+
+static void HrStamp(struct bfs_handler *h, hr_stamp_t *s)
+{
+    s->dir_root = h->fs.dir_tree.tree.root;
+    s->dir_generation = h->fs.dir_tree.tree.generation;
+    s->recovery_generation = h->fs.recovery_generation;
+    s->inode_root = h->fs.inode_tree.root;
+    s->inode_generation = h->fs.inode_tree.generation;
+    s->pending_version = bfs_inode_pending_version(&h->fs.inode_tree);
+}
+
+static bool HrStampEqual(const hr_stamp_t *a, const hr_stamp_t *b)
+{
+    return a->dir_root == b->dir_root && a->dir_generation == b->dir_generation &&
+           a->recovery_generation == b->recovery_generation &&
+           a->inode_root == b->inode_root && a->inode_generation == b->inode_generation &&
+           a->pending_version == b->pending_version;
+}
+
+static hr_dir_t *HrDir(struct hr_state *hr, uint32_t ino)
+{
+    for (uint32_t i = 0; i < hr->used; i++)
+        if (hr->dirs[i].ino == ino) return &hr->dirs[i];
+    hr_dir_t *d;
+    if (hr->used < HR_DIRS) {
+        d = &hr->dirs[hr->used++];
+    } else {
+        d = &hr->dirs[hr->next_evict++ % HR_DIRS];
+        hr->rep.evictions++;
+    }
+    memset(d, 0, sizeof(*d));
+    d->ino = ino;
+    return d;
+}
+
+static uint8_t HrClassify(const hr_rec_t *last, bool use_stamps, const hr_stamp_t *now,
+                          uint32_t counter, const bfs_lock_t *lk)
+{
+    if (!last->valid) return HR_CLASS_NEW;
+    bool same = use_stamps ? HrStampEqual(&last->stamp, now) : last->counter == counter;
+    if (!same) return HR_CLASS_CHANGED;
+    return last->lock == lk ? HR_CLASS_SAME_LOCK : HR_CLASS_OTHER_LOCK;
+}
+
+/* A pass over the directory of lk starts. */
+static void HrBegin(struct bfs_handler *h, bfs_lock_t *lk, int kind, bool pattern)
+{
+    struct hr_state *hr = HrGet(h);
+    if (!hr) return;
+    hr_lock_pass_t *pass = &lk->hr[kind];
+    if (pass->active) hr->rep.passes_abandoned[kind]++;
+    hr_dir_t *d = HrDir(hr, lk->ino);
+    hr_stamp_t now;
+    HrStamp(h, &now);
+    for (int test = 0; test < HR_TESTS; test++) {
+        for (int scope = 0; scope < HR_SCOPES; scope++) {
+            const hr_rec_t *last = &d->last[scope == HR_SCOPE_KIND ? kind : 2][test];
+            uint8_t cls = HrClassify(last, test == HR_TEST_STAMPS, &now, h->volume_changes, lk);
+            pass->cls[test][scope] = cls;
+            hr->rep.starts[kind][test][scope][cls]++;
+        }
+    }
+    pass->active = true;
+    pass->stamp = now;
+    pass->counter = h->volume_changes;
+    if (pattern) hr->rep.pattern_starts++;
+}
+
+/* A call of the pass returned entries. complete: no entries remain. */
+static void HrEnd(struct bfs_handler *h, bfs_lock_t *lk, int kind, uint32_t entries, bool complete)
+{
+    struct hr_state *hr = HrGet(h);
+    if (!hr) return;
+    hr_lock_pass_t *pass = &lk->hr[kind];
+    hr->rep.calls[kind]++;
+    hr->rep.entries_returned[kind] += entries;
+    if (!pass->active) {
+        hr->rep.orphan_entries[kind] += entries;
+        return;
+    }
+    for (int test = 0; test < HR_TESTS; test++)
+        for (int scope = 0; scope < HR_SCOPES; scope++)
+            hr->rep.entries[kind][test][scope][pass->cls[test][scope]] += entries;
+    if (!complete) return;
+    pass->active = false;
+    hr->rep.passes_complete[kind]++;
+    hr_stamp_t now;
+    HrStamp(h, &now);
+    bool stamps_ok = HrStampEqual(&pass->stamp, &now);
+    bool counter_ok = pass->counter == h->volume_changes;
+    if (!stamps_ok) hr->rep.passes_changed[kind]++;
+    hr_dir_t *d = HrDir(hr, lk->ino);
+    const int slots[2] = { kind, 2 };
+    for (int i = 0; i < 2; i++) {
+        hr_rec_t *rec = d->last[slots[i]];
+        if (stamps_ok) {
+            rec[HR_TEST_STAMPS].valid = true;
+            rec[HR_TEST_STAMPS].stamp = pass->stamp;
+            rec[HR_TEST_STAMPS].lock = lk;
+        }
+        if (counter_ok) {
+            rec[HR_TEST_COUNTER].valid = true;
+            rec[HR_TEST_COUNTER].counter = pass->counter;
+            rec[HR_TEST_COUNTER].lock = lk;
+        }
+    }
+}
+
+/* A lock is released: its passes end and no record names it any more. */
+static void HrLockFreed(struct bfs_handler *h, const bfs_lock_t *lk)
+{
+    struct hr_state *hr = h->hr;
+    if (!hr) return;
+    for (int kind = 0; kind < HR_KINDS; kind++)
+        if (lk->hr[kind].active) hr->rep.passes_abandoned[kind]++;
+    for (uint32_t i = 0; i < hr->used; i++)
+        for (int slot = 0; slot < 3; slot++)
+            for (int test = 0; test < HR_TESTS; test++)
+                if (hr->dirs[i].last[slot][test].lock == lk) hr->dirs[i].last[slot][test].lock = NULL;
+}
+#endif
