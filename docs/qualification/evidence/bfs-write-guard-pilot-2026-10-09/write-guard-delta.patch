+TEST_SUITE_BEGIN("File Write Guard")
+    TEST_RUN(test_denied_write_changes_nothing);
+    TEST_RUN(test_denied_zero_length_write);
+    TEST_RUN(test_other_protection_bits_allow_the_write);
+    TEST_RUN(test_check_uses_the_current_protection);
+    TEST_RUN(test_check_follows_inode_published_by_another_handle);
+    TEST_RUN(test_denied_write_to_open_unlinked_inode);
+    TEST_RUN(test_checked_write_looks_up_the_inode_once);
+    TEST_RUN(test_invalid_length_takes_precedence);
+    TEST_RUN(test_read_only_mount_takes_precedence);
+TEST_SUITE_END()
