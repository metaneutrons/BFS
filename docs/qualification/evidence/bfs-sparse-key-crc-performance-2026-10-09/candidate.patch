diff --git a/src/core/crc32_zero.c b/src/core/crc32_zero.c
index f1b3cf9..5350227 100644
--- a/src/core/crc32_zero.c
+++ b/src/core/crc32_zero.c
@@ -361,3 +361,49 @@ uint32_t bfs_crc32_zeros(uint32_t initial, uint32_t length)
     }
     return ~crc;
 }
+
+#if defined(__GNUC__)
+typedef uint32_t __attribute__((__may_alias__, __aligned__(1))) sparse_word_t;
+#endif
+
+/* The caller checks that a complete 16-byte unit remains. */
+static bool sparse_unit_zero(const uint8_t *bytes)
+{
+#if defined(__GNUC__)
+    const sparse_word_t *words = (const sparse_word_t *)(const void *)bytes;
+    return (words[0] | words[1] | words[2] | words[3]) == 0;
+#else
+    for (unsigned i = 0; i < 16; i++)
+        if (bytes[i] != 0) return false;
+    return true;
+#endif
+}
+
+uint32_t bfs_crc32_sparse(uint32_t initial, const void *data, uint32_t length)
+{
+    if (length < 64u) return bfs_crc32(initial, data, length);
+    const uint8_t *bytes = data;
+    uint32_t position = 0;
+    uint32_t pending = 0;
+    uint32_t crc = initial;
+
+    while (length - position >= 16u) {
+        if (!sparse_unit_zero(bytes + position)) {
+            position += 16u;
+            continue;
+        }
+        uint32_t zero_start = position;
+        do {
+            position += 16u;
+        } while (length - position >= 16u && sparse_unit_zero(bytes + position));
+        uint32_t zero_length = position - zero_start;
+        if (zero_length < 64u) continue;
+        if (zero_start > pending)
+            crc = bfs_crc32(crc, bytes + pending, zero_start - pending);
+        crc = bfs_crc32_zeros(crc, zero_length);
+        pending = position;
+    }
+    if (pending < length)
+        crc = bfs_crc32(crc, bytes + pending, length - pending);
+    return crc;
+}
