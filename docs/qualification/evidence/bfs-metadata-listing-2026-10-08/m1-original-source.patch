+static bfs_err_t file_open_from_tree_unlocked(bfs_file_t *f, bfs_fs_t *fs,
+                                              bfs_btree_t *inode_tree,
+                                              uint32_t inode_nr, bool unlinked)
+{
+    if (!f || !fs || !fs->mounted || !inode_tree || inode_nr == 0)
+        return BFS_ERR_INVAL;
+    if (fs->recovery_error != BFS_OK) return fs->recovery_error;
+    /* Keep the prior failure state: a failed open leaves a cleared, identified
+     * handle rather than preserving uninitialized or earlier caller bytes. */
+    memset(f, 0, sizeof(*f));
+    f->fs = fs;
+    f->inode_tree = inode_tree;
+    f->inode_nr = inode_nr;
+    f->recovery_generation = fs->recovery_generation;
+    f->unlinked = unlinked;
+    bfs_inode_t inode;
+    bfs_err_t err = unlinked ? bfs_inode_read_unlinked(inode_tree, inode_nr, &inode)
+                             : bfs_inode_read(inode_tree, inode_nr, &inode);
+    if (err != BFS_OK) return err;
+    return file_open_from_inode_unlocked(f, fs, inode_tree, inode_nr, unlinked,
+                                         &inode);
+}
+
 bfs_err_t bfs_file_open_unlocked(bfs_file_t *f, bfs_fs_t *fs, uint32_t inode_nr)
 {
     return file_open_from_tree_unlocked(f, fs, &fs->inode_tree, inode_nr, false);
 }
 
+static void file_inode_seed_store(file_inode_seed_t *seed, const bfs_file_t *f,
+                                  const bfs_inode_t *inode)
+{
+    if (!seed) return;
+    seed->valid = true;
+    seed->fs = f->fs;
+    seed->tree = f->inode_tree;
+    seed->root = f->inode_tree->root;
+    seed->generation = f->inode_tree->generation;
+    seed->recovery_generation = f->fs->recovery_generation;
+    seed->inode_nr = f->inode_nr;
+    seed->unlinked = f->unlinked;
+    seed->inode = *inode;
+}
+
+static bool file_inode_seed_matches(const file_inode_seed_t *seed,
+                                    const bfs_file_t *f)
+{
+    return seed && seed->valid && seed->fs == f->fs &&
+           seed->tree == f->inode_tree && seed->root == f->inode_tree->root &&
+           seed->generation == f->inode_tree->generation &&
+           seed->recovery_generation == f->fs->recovery_generation &&
+           seed->inode_nr == f->inode_nr && seed->unlinked == f->unlinked;
+}
