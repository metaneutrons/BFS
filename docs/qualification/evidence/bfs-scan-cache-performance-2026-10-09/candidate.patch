+static void test_scan_advice_demotes_clean_victim(void)
+{
+    memory_bio_t ordinary_memory, scan_memory;
+    bfs_cache_t ordinary_cache, scan_cache;
+    uint8_t buffer[BLOCK_SIZE];
+    memory_init(&ordinary_memory);
+    memory_init(&scan_memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&ordinary_cache, &ordinary_memory.bio, 2), BFS_OK);
+    TEST_ASSERT_EQ(bfs_cache_init(&scan_cache, &scan_memory.bio, 2), BFS_OK);
+
+    /* The same access sequence makes block 1 least-recently-used and block 2
+     * most-recently-used in both caches. Ordinary LRU evicts block 1. */
+    TEST_ASSERT_EQ(bfs_bio_read(&ordinary_cache.bio, 1, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&ordinary_cache.bio, 2, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&ordinary_cache.bio, 2, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&ordinary_cache.bio, 3, buffer), BFS_OK);
+    TEST_ASSERT(!cache_has_block(&ordinary_cache, 1));
+    TEST_ASSERT(cache_has_block(&ordinary_cache, 2));
+
+    TEST_ASSERT_EQ(bfs_bio_read(&scan_cache.bio, 1, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&scan_cache.bio, 2, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&scan_cache.bio, 2, buffer), BFS_OK);
+    bfs_bio_advise_scan_block(&scan_cache.bio, 2);
+    bfs_cache_slot_t *scan_slot = cache_slot_for_block(&scan_cache, 2);
+    TEST_ASSERT(scan_slot != NULL);
+    TEST_ASSERT(scan_slot->scan_cold);
+    TEST_ASSERT_EQ(bfs_bio_read(&scan_cache.bio, 3, buffer), BFS_OK);
+    TEST_ASSERT(cache_has_block(&scan_cache, 1));
+    TEST_ASSERT(!cache_has_block(&scan_cache, 2));
+
+    bfs_cache_destroy(&ordinary_cache);
+    bfs_cache_destroy(&scan_cache);
+}
