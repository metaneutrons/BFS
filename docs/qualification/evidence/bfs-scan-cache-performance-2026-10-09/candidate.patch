+static void test_scan_advice_preserves_resident_validation_state(void)
+{
+    memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t buffer[BLOCK_SIZE];
+    uint8_t before[BLOCK_SIZE];
+    uint64_t epoch_before, epoch_after;
+    bfs_node_validation_t validation = {
+        .key_compare = memory_key_compare,
+        .key_size = 4,
+        .val_size = 4,
+        .block_size = BLOCK_SIZE,
+        .block_count = BLOCK_COUNT,
+    };
+    memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 7, buffer), BFS_OK);
+    bfs_bio_mark_node_crc_valid(&cache.bio, 7);
+    bfs_bio_mark_node_structure_valid(&cache.bio, 7, &validation);
+    TEST_ASSERT(bfs_bio_node_crc_valid(&cache.bio, 7));
+    TEST_ASSERT(bfs_bio_node_structure_valid(&cache.bio, 7, &validation));
+    bfs_cache_slot_t *slot = cache_slot_for_block(&cache, 7);
+    TEST_ASSERT(slot != NULL);
+    memcpy(before, slot->data, BLOCK_SIZE);
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &epoch_before));
+
+    bfs_bio_advise_scan_block(&cache.bio, 7);
+
+    TEST_ASSERT(slot->scan_cold);
+    TEST_ASSERT(!slot->dirty);
+    TEST_ASSERT_MEM_EQ(slot->data, before, BLOCK_SIZE);
+    TEST_ASSERT(bfs_bio_node_crc_valid(&cache.bio, 7));
+    TEST_ASSERT(bfs_bio_node_structure_valid(&cache.bio, 7, &validation));
+    TEST_ASSERT(slot->node_validation.key_compare == validation.key_compare);
+    TEST_ASSERT_EQ(slot->node_validation.key_size, validation.key_size);
+    TEST_ASSERT_EQ(slot->node_validation.val_size, validation.val_size);
+    TEST_ASSERT_EQ(slot->node_validation.block_size, validation.block_size);
+    TEST_ASSERT_EQ(slot->node_validation.block_count, validation.block_count);
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &epoch_after));
+    TEST_ASSERT_EQ(epoch_after, epoch_before);
+
+    bfs_cache_destroy(&cache);
+}
