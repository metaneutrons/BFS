+static void test_scan_advice_never_evicts_dirty_and_reports_writeback_failure(void)
+{
+    memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t buffer[BLOCK_SIZE];
+    uint8_t dirty_image[BLOCK_SIZE];
+    uint8_t readback[BLOCK_SIZE];
+    memset(dirty_image, 0xD6, sizeof(dirty_image));
+    memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 3), BFS_OK);
+    bfs_cache_set_deferred_node_limit(&cache, 1);
+
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 1, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 2, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_defer_node(&cache.bio, 0, dirty_image,
+                                      keep_node_image, NULL), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 3, buffer), BFS_OK);
+    bfs_bio_advise_scan_block(&cache.bio, 0);
+    bfs_cache_slot_t *dirty_slot = cache_slot_for_block(&cache, 0);
+    TEST_ASSERT(dirty_slot != NULL);
+    TEST_ASSERT(dirty_slot->dirty);
+    TEST_ASSERT(!dirty_slot->scan_cold);
+    bfs_bio_advise_scan_block(&cache.bio, 3);
+    bfs_cache_slot_t *scan_slot = cache_slot_for_block(&cache, 3);
+    TEST_ASSERT(scan_slot != NULL);
+    TEST_ASSERT(scan_slot->scan_cold);
+
+    /* Pressure must reclaim the advised clean block while preserving the
+     * only in-cache copy of the deferred image. */
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 4, buffer), BFS_OK);
+    TEST_ASSERT(!cache_has_block(&cache, 3));
+    dirty_slot = cache_slot_for_block(&cache, 0);
+    TEST_ASSERT(dirty_slot != NULL);
+    TEST_ASSERT(dirty_slot->dirty);
+    TEST_ASSERT_EQ(cache.dirty_count, 1);
+    TEST_ASSERT_MEM_EQ(dirty_slot->data, dirty_image, BLOCK_SIZE);
+
+    memory.fail_write = 1;
+    TEST_ASSERT_EQ(bfs_bio_flush_deferred(&cache.bio), BFS_ERR_IO);
+    TEST_ASSERT_EQ(memory.writes, 1);
+    dirty_slot = cache_slot_for_block(&cache, 0);
+    TEST_ASSERT(dirty_slot != NULL);
+    TEST_ASSERT(dirty_slot->dirty);
+    TEST_ASSERT_EQ(cache.dirty_count, 1);
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 0, readback), BFS_OK);
+    TEST_ASSERT_MEM_EQ(readback, dirty_image, BLOCK_SIZE);
+
+    bfs_cache_destroy(&cache);
+}
