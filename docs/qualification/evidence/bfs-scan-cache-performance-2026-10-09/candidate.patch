diff --git a/tests/test_scan_cache_priority.c b/tests/test_scan_cache_priority.c
new file mode 100644
index 0000000..efc3861
--- /dev/null
+++ b/tests/test_scan_cache_priority.c
@@ -0,0 +1,375 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+/* End-to-end coverage for scan-leaf cache replacement advice. */
+
+#include "test_harness.h"
+#include "bfs_alloc.h"
+#include "bfs_btree_internal.h"
+#include "bfs_cache.h"
+#include "bfs_dir.h"
+#include "block_device_emu.h"
+
+#include <stdio.h>
+#include <stdint.h>
+#include <unistd.h>
+
+#define SCAN_PRIORITY_IMAGE "test_scan_cache_priority.img"
+#define SCAN_PRIORITY_BLOCK_SIZE 4096u
+#define SCAN_PRIORITY_BLOCK_COUNT 8192u
+#define SCAN_PRIORITY_CACHE_SLOTS 64u
+#define SCAN_PRIORITY_PARENT 42u
+#define SCAN_PRIORITY_ENTRY_COUNT 72u
+#define SCAN_PRIORITY_INODE_BASE 1000u
+#define SCAN_PRIORITY_NAME_SIZE 20u
+
+typedef struct {
+    bfs_bio_t *device;
+    bfs_cache_t cache;
+    bfs_freespace_t space;
+    bfs_dir_tree_t dirs;
+    bool cache_ready;
+} scan_priority_fixture_t;
+
+typedef struct {
+    bfs_cache_t *cache;
+    bool seen[SCAN_PRIORITY_ENTRY_COUNT];
+    uint32_t count;
+    bool duplicate;
+    bool overflow;
+    bool invalid_entry;
+    bool callback_copy_private;
+    bool callback_saw_cold_leaf;
+} directory_scan_log_t;
+
+typedef struct {
+    bfs_cache_t *cache;
+    bfs_blk_t advised_block;
+    uint32_t calls;
+    bool callback_copy_private;
+    bool callback_saw_cold_leaf;
+    bfs_err_t write_error;
+} mutating_stop_log_t;
+
+typedef struct {
+    bfs_cache_t *cache;
+    bfs_blk_t advised_block;
+    uint32_t calls;
+    bool callback_saw_cold_leaf;
+} cursor_copy_log_t;
+
+typedef struct {
+    const bfs_bio_ops_t *cache_ops;
+    uint32_t calls;
+} advice_order_probe_t;
+
+static advice_order_probe_t *active_advice_probe;
+
+static bool fixture_open(scan_priority_fixture_t *fixture)
+{
+    memset(fixture, 0, sizeof(*fixture));
+    (void)unlink(SCAN_PRIORITY_IMAGE);
+    fixture->device = bio_emu_create(SCAN_PRIORITY_IMAGE,
+                                     SCAN_PRIORITY_BLOCK_SIZE,
+                                     SCAN_PRIORITY_BLOCK_COUNT);
+    if (!fixture->device) return false;
+    if (bfs_cache_init(&fixture->cache, fixture->device,
+                       SCAN_PRIORITY_CACHE_SLOTS) != BFS_OK)
+        goto fail;
+    fixture->cache_ready = true;
+    if (bfs_freespace_init(&fixture->space, &fixture->cache.bio,
+                           BFS_BLK_NULL, 1) != BFS_OK)
+        goto fail;
+    if (bfs_freespace_add(&fixture->space, 2,
+                          SCAN_PRIORITY_BLOCK_COUNT - 2) != BFS_OK)
+        goto fail;
+    if (bfs_freespace_refill_reserve(&fixture->space) != BFS_OK)
+        goto fail;
+    if (bfs_dir_init(&fixture->dirs, &fixture->cache.bio,
+                     bfs_freespace_allocator(&fixture->space),
+                     BFS_BLK_NULL, 1) != BFS_OK)
+        goto fail;
+    return true;
+
+fail:
+    if (fixture->cache_ready) bfs_cache_destroy(&fixture->cache);
+    if (fixture->device) bfs_bio_close(fixture->device);
+    fixture->device = NULL;
+    (void)unlink(SCAN_PRIORITY_IMAGE);
+    return false;
+}
+
+static void fixture_close(scan_priority_fixture_t *fixture)
+{
+    if (fixture->cache_ready) {
+        bfs_cache_destroy(&fixture->cache);
+        fixture->cache_ready = false;
+    }
+    if (fixture->device) {
+        bfs_bio_close(fixture->device);
+        fixture->device = NULL;
+    }
+    (void)unlink(SCAN_PRIORITY_IMAGE);
+}
+
+static bool fixture_insert_entries(scan_priority_fixture_t *fixture)
+{
+    for (uint32_t i = 0; i < SCAN_PRIORITY_ENTRY_COUNT; i++) {
+        char name[SCAN_PRIORITY_NAME_SIZE];
+        int length = snprintf(name, sizeof(name), "item%04u", i);
+        if (length <= 0 || (size_t)length >= sizeof(name)) return false;
+        if (bfs_dir_insert(&fixture->dirs, SCAN_PRIORITY_PARENT, name,
+                           (uint8_t)length, SCAN_PRIORITY_INODE_BASE + i,
+                           BFS_INODE_FILE) != BFS_OK)
+            return false;
+    }
+    return fixture->dirs.tree.height > 1;
+}
+
+static uint32_t cold_slot_count(const bfs_cache_t *cache)
+{
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < cache->num_slots; i++)
+        if (cache->slots[i].blk != UINT32_MAX && cache->slots[i].scan_cold)
+            count++;
+    return count;
+}
+
+static bfs_cache_slot_t *cold_slot(bfs_cache_t *cache)
+{
+    for (uint32_t i = 0; i < cache->num_slots; i++)
+        if (cache->slots[i].blk != UINT32_MAX && cache->slots[i].scan_cold)
+            return &cache->slots[i];
+    return NULL;
+}
+
+/* Simulate the resident block buffer being reused as soon as advice returns.
+ * The scan must already have copied all entries to private memory. */
+static void poison_resident_after_advice(bfs_bio_t *bio, bfs_blk_t blk)
+{
+    advice_order_probe_t *probe = active_advice_probe;
+    probe->cache_ops->advise_scan_block(bio, blk);
+    bfs_cache_t *cache = (bfs_cache_t *)bio;
+    for (uint32_t i = 0; i < cache->num_slots; i++) {
+        bfs_cache_slot_t *slot = &cache->slots[i];
+        if (slot->blk != blk) continue;
+        memset(slot->data, 0xE3, bio->block_size);
+        probe->calls++;
+        return;
+    }
+}
+
+static bool pointer_in_cache_slot(const bfs_cache_t *cache, const void *pointer)
+{
+    uintptr_t address = (uintptr_t)pointer;
+    for (uint32_t i = 0; i < cache->num_slots; i++) {
+        if (!cache->slots[i].data) continue;
+        uintptr_t start = (uintptr_t)cache->slots[i].data;
+        if (address >= start && address - start < cache->bio.block_size)
+            return true;
+    }
+    return false;
+}
+
+static bool collect_directory_entry(const char *name, uint8_t name_len,
+                                    uint32_t inode_nr, uint32_t entry_type,
+                                    void *ctx)
+{
+    directory_scan_log_t *log = (directory_scan_log_t *)ctx;
+    if (log->count == 0) {
+        log->callback_copy_private =
+            !pointer_in_cache_slot(log->cache, name);
+        log->callback_saw_cold_leaf = cold_slot_count(log->cache) != 0;
+    }
+    if (log->count >= SCAN_PRIORITY_ENTRY_COUNT) log->overflow = true;
+    if (entry_type != BFS_INODE_FILE ||
+        inode_nr < SCAN_PRIORITY_INODE_BASE ||
+        inode_nr - SCAN_PRIORITY_INODE_BASE >= SCAN_PRIORITY_ENTRY_COUNT) {
+        log->invalid_entry = true;
+    } else {
+        uint32_t index = inode_nr - SCAN_PRIORITY_INODE_BASE;
+        char expected[SCAN_PRIORITY_NAME_SIZE];
+        int expected_len = snprintf(expected, sizeof(expected), "item%04u", index);
+        if (expected_len <= 0 || name_len != (uint8_t)expected_len ||
+            memcmp(name, expected, name_len) != 0)
+            log->invalid_entry = true;
+        if (log->seen[index]) log->duplicate = true;
+        log->seen[index] = true;
+    }
+    log->count++;
+    return true;
+}
+
+static bool mutate_advised_leaf_and_stop(const char *name, uint8_t name_len,
+                                         uint32_t inode_nr,
+                                         uint32_t entry_type, void *ctx)
+{
+    (void)name;
+    (void)name_len;
+    (void)inode_nr;
+    (void)entry_type;
+    mutating_stop_log_t *log = (mutating_stop_log_t *)ctx;
+    log->calls++;
+    log->callback_copy_private =
+        !pointer_in_cache_slot(log->cache, name);
+    bfs_cache_slot_t *slot = cold_slot(log->cache);
+    if (!slot) {
+        log->write_error = BFS_ERR_CORRUPT;
+        return false;
+    }
+    log->callback_saw_cold_leaf = true;
+    log->advised_block = slot->blk;
+    uint8_t replacement[SCAN_PRIORITY_BLOCK_SIZE];
+    memset(replacement, 0xA5, sizeof(replacement));
+    log->write_error = bfs_bio_write(&log->cache->bio, slot->blk, replacement);
+    return false;
+}
+
+static bool stop_and_observe_cursor_leaf(const char *name, uint8_t name_len,
+                                         uint32_t inode_nr,
+                                         uint32_t entry_type, void *ctx)
+{
+    (void)name;
+    (void)name_len;
+    (void)inode_nr;
+    (void)entry_type;
+    cursor_copy_log_t *log = (cursor_copy_log_t *)ctx;
+    log->calls++;
+    bfs_cache_slot_t *slot = cold_slot(log->cache);
+    if (slot) {
+        log->advised_block = slot->blk;
+        log->callback_saw_cold_leaf = true;
+    }
+    return false;
+}
+
+static bool stop_btree_scan(const void *key, const void *value, void *ctx)
+{
+    (void)key;
+    (void)value;
+    cursor_copy_log_t *log = (cursor_copy_log_t *)ctx;
+    log->calls++;
+    log->callback_saw_cold_leaf = cold_slot_count(log->cache) != 0;
+    return false;
+}
+
+static void test_directory_scan_advice_is_opt_in_and_copy_safe(void)
+{
+    scan_priority_fixture_t fixture;
+    TEST_ASSERT(fixture_open(&fixture));
+    TEST_ASSERT(fixture_insert_entries(&fixture));
+    TEST_ASSERT(fixture.dirs.tree.ops->scan_cache_cold);
+
+    const bfs_bio_ops_t *cache_ops = fixture.cache.bio.ops;
+    bfs_bio_ops_t advice_probe_ops = *cache_ops;
+    advice_order_probe_t advice_probe = {.cache_ops = cache_ops};
+    advice_probe_ops.advise_scan_block = poison_resident_after_advice;
+    active_advice_probe = &advice_probe;
+    fixture.cache.bio.ops = &advice_probe_ops;
+    directory_scan_log_t scan = {.cache = &fixture.cache};
+    bfs_cache_invalidate(&fixture.cache);
+    TEST_ASSERT_EQ(bfs_dir_scan(&fixture.dirs, SCAN_PRIORITY_PARENT,
+                                collect_directory_entry, &scan), BFS_OK);
+    fixture.cache.bio.ops = cache_ops;
+    active_advice_probe = NULL;
+    TEST_ASSERT(advice_probe.calls > 1);
+    TEST_ASSERT_EQ(scan.count, SCAN_PRIORITY_ENTRY_COUNT);
+    TEST_ASSERT(!scan.duplicate);
+    TEST_ASSERT(!scan.overflow);
+    TEST_ASSERT(!scan.invalid_entry);
+    TEST_ASSERT(scan.callback_copy_private);
+    TEST_ASSERT(scan.callback_saw_cold_leaf);
+    TEST_ASSERT(cold_slot_count(&fixture.cache) > 1);
+
+    /* The same real directory scan does not advise leaves when its operation
+     * table has not opted in. */
+    const bfs_btree_ops_t *directory_ops = fixture.dirs.tree.ops;
+    bfs_btree_ops_t no_advice_ops = *directory_ops;
+    no_advice_ops.scan_cache_cold = false;
+    fixture.dirs.tree.ops = &no_advice_ops;
+    memset(&scan, 0, sizeof(scan));
+    scan.cache = &fixture.cache;
+    bfs_cache_invalidate(&fixture.cache);
+    TEST_ASSERT_EQ(bfs_dir_scan(&fixture.dirs, SCAN_PRIORITY_PARENT,
+                                collect_directory_entry, &scan), BFS_OK);
+    TEST_ASSERT_EQ(scan.count, SCAN_PRIORITY_ENTRY_COUNT);
+    TEST_ASSERT(!scan.duplicate);
+    TEST_ASSERT(!scan.overflow);
+    TEST_ASSERT(!scan.invalid_entry);
+    TEST_ASSERT(!scan.callback_saw_cold_leaf);
+    TEST_ASSERT_EQ(cold_slot_count(&fixture.cache), 0);
+    fixture.dirs.tree.ops = directory_ops;
+
+    /* A callback may mutate the advised block and stop. The cache write
+     * clears the cold flag; the scan must not re-advise its stale path after
+     * that callback. */
+    bfs_cache_invalidate(&fixture.cache);
+    mutating_stop_log_t mutation = {
+        .cache = &fixture.cache,
+        .advised_block = UINT32_MAX,
+        .write_error = BFS_ERR_CORRUPT,
+    };
+    TEST_ASSERT_EQ(bfs_dir_scan(&fixture.dirs, SCAN_PRIORITY_PARENT,
+                                mutate_advised_leaf_and_stop, &mutation), BFS_OK);
+    TEST_ASSERT_EQ(mutation.calls, 1);
+    TEST_ASSERT(mutation.callback_copy_private);
+    TEST_ASSERT(mutation.callback_saw_cold_leaf);
+    TEST_ASSERT_EQ(mutation.write_error, BFS_OK);
+    bfs_cache_slot_t *mutated_slot = NULL;
+    for (uint32_t i = 0; i < fixture.cache.num_slots; i++)
+        if (fixture.cache.slots[i].blk == mutation.advised_block)
+            mutated_slot = &fixture.cache.slots[i];
+    TEST_ASSERT(mutated_slot != NULL);
+    TEST_ASSERT(!mutated_slot->scan_cold);
+    TEST_ASSERT_EQ(cold_slot_count(&fixture.cache), 0);
+
+    fixture_close(&fixture);
+}
+
+static void test_cursor_copy_without_path_identity_is_not_advised(void)
+{
+    scan_priority_fixture_t fixture;
+    TEST_ASSERT(fixture_open(&fixture));
+    TEST_ASSERT(fixture_insert_entries(&fixture));
+
+    bfs_cache_invalidate(&fixture.cache);
+    bfs_btree_cursor_t cursor;
+    bfs_btree_cursor_init(&cursor);
+    cursor_copy_log_t first_scan = {
+        .cache = &fixture.cache,
+        .advised_block = UINT32_MAX,
+    };
+    TEST_ASSERT_EQ(bfs_dir_scan_cursor(&fixture.dirs, &cursor,
+                                      SCAN_PRIORITY_PARENT, NULL, 0,
+                                      stop_and_observe_cursor_leaf,
+                                      &first_scan), BFS_OK);
+    TEST_ASSERT_EQ(first_scan.calls, 1);
+    TEST_ASSERT(first_scan.callback_saw_cold_leaf);
+    TEST_ASSERT(cursor.stopped);
+    TEST_ASSERT(first_scan.advised_block != UINT32_MAX);
+    TEST_ASSERT(cold_slot_count(&fixture.cache) > 0);
+
+    /* A normal demand read re-promotes the resident block without invalidating
+     * the cursor's copied leaf or its BIO epoch. */
+    uint8_t buffer[SCAN_PRIORITY_BLOCK_SIZE];
+    TEST_ASSERT_EQ(bfs_bio_read(&fixture.cache.bio, first_scan.advised_block,
+                                buffer), BFS_OK);
+    TEST_ASSERT_EQ(cold_slot_count(&fixture.cache), 0);
+    const void *stop_key = bfs_btree_cursor_stop_key(&fixture.dirs.tree,
+                                                    &cursor);
+    TEST_ASSERT(stop_key != NULL);
+
+    cursor_copy_log_t cursor_scan = {.cache = &fixture.cache};
+    TEST_ASSERT_EQ(bfs_btree_scan_cursor(&fixture.dirs.tree, &cursor,
+                                         stop_key, stop_btree_scan,
+                                         &cursor_scan), BFS_OK);
+    TEST_ASSERT_EQ(cursor_scan.calls, 1);
+    TEST_ASSERT(!cursor_scan.callback_saw_cold_leaf);
+    TEST_ASSERT_EQ(cold_slot_count(&fixture.cache), 0);
+
+    bfs_btree_cursor_release(&cursor);
+    fixture_close(&fixture);
+}
+
+TEST_SUITE_BEGIN("Scan Cache Priority")
+    TEST_RUN(test_directory_scan_advice_is_opt_in_and_copy_safe);
+    TEST_RUN(test_cursor_copy_without_path_identity_is_not_advised);
+TEST_SUITE_END()
