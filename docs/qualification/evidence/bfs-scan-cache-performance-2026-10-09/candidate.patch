+static void test_scan_advice_cleared_by_demand_io_and_slot_lifecycle(void)
+{
+    memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t buffer[BLOCK_SIZE];
+    uint8_t replacement[BLOCK_SIZE];
+    memory_init(&memory);
+    memset(replacement, 0x79, sizeof(replacement));
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 5, buffer), BFS_OK);
+    bfs_bio_advise_scan_block(&cache.bio, 5);
+    TEST_ASSERT(cache_block_is_scan_cold(&cache, 5));
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 5, buffer), BFS_OK);
+    TEST_ASSERT(!cache_block_is_scan_cold(&cache, 5));
+
+    bfs_bio_advise_scan_block(&cache.bio, 5);
+    TEST_ASSERT(cache_block_is_scan_cold(&cache, 5));
+    TEST_ASSERT_EQ(bfs_bio_write(&cache.bio, 5, replacement), BFS_OK);
+    TEST_ASSERT(!cache_block_is_scan_cold(&cache, 5));
+
+    bfs_bio_advise_scan_block(&cache.bio, 5);
+    TEST_ASSERT(cache_block_is_scan_cold(&cache, 5));
+    bfs_cache_invalidate(&cache);
+    TEST_ASSERT(!cache_has_block(&cache, 5));
+    for (uint32_t i = 0; i < cache.num_slots; i++)
+        TEST_ASSERT(!cache.slots[i].scan_cold);
+
+    /* An evicted block number can be reused without inheriting its old hint. */
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 5, buffer), BFS_OK);
+    bfs_bio_advise_scan_block(&cache.bio, 5);
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 6, buffer), BFS_OK);
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 7, buffer), BFS_OK);
+    TEST_ASSERT(!cache_has_block(&cache, 5));
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 5, buffer), BFS_OK);
+    bfs_cache_slot_t *reused_slot = cache_slot_for_block(&cache, 5);
+    TEST_ASSERT(reused_slot != NULL);
+    TEST_ASSERT(!reused_slot->scan_cold);
+
+    bfs_cache_destroy(&cache);
+}
