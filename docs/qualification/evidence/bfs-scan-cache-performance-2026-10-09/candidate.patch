+
+    /* Raw BIOs have no advisory operation; null and out-of-range calls are
+     * also guarded by the public wrapper. */
+    bfs_bio_advise_scan_block(&memory.bio, 1);
+    bfs_bio_advise_scan_block(NULL, 1);
+    bfs_bio_advise_scan_block(&cache.bio, BLOCK_COUNT);
+    TEST_ASSERT(!cache.slots[0].scan_cold);
+
+    bfs_bio_advise_scan_block(&cache.bio, 1);
+    TEST_ASSERT(cache.slots[0].scan_cold);
+    bfs_cache_destroy(&cache);
+}
+
 static void test_write_through(void)
 {
     memory_bio_t memory;
@@ -709,6 +925,11 @@ TEST_SUITE_BEGIN("Block Cache")
     TEST_RUN(test_invalid_initialization);
