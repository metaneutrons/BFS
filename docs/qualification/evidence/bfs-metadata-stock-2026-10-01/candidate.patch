index 0000000..edf8fa3
--- /dev/null
+++ b/tests/test_alloc_metadata_stock.c
@@ -0,0 +1,805 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+/* Mounted tests for bounded pre-publication metadata stock. */
+
+#include "test_harness.h"
+#include "bfs_alloc.h"
+#include "bfs_fs.h"
+#include "bfs_ondisk.h"
+#include "bfs_superblock.h"
+
+#include <stdlib.h>
+
+#define TEST_BLOCK_COUNT 4096u
+#define HEIGHT_ONE_FLOOR 20u
+#define STOCK_EXTRA 20u
+
+typedef struct {
+    bfs_bio_t bio;
+    uint8_t *bytes;
+    bfs_fs_t *observed_fs;
+    uint32_t reads;
+    uint32_t writes;
+    uint32_t syncs;
+    uint32_t fail_read_at;
+    uint32_t fail_write_at;
+    uint32_t fail_sync_at;
+    bfs_err_t read_error;
+    bfs_err_t write_error;
+    bfs_err_t sync_error;
+    bool partial_write;
+    bool track_settlement;
+    uint32_t guarded_writes;
+    uint32_t unguarded_writes;
+    uint32_t guarded_syncs;
+    uint32_t unguarded_syncs;
+} memory_device_t;
+
+typedef struct {
+    memory_device_t device;
+    bfs_fs_t fs;
+} fixture_t;
+
+typedef struct {
+    bfs_superblock_t working_sb;
+    bfs_superblock_t committed_sb;
+    bfs_blk_t reserve[BFS_ALLOC_RESERVE_SIZE];
+    bfs_blk_t pending[BFS_PENDING_FREES_MAX];
+    uint32_t reserve_count;
+    uint32_t pending_count;
+    bfs_blk_t root;
+    uint32_t height;
+    uint32_t total_free;
+    bfs_blk_t roving;
+    uint64_t live_txn_id;
+    bool in_alloc;
+    bfs_err_t free_sink_error;
+    bfs_err_t recovery_error;
+} allocator_snapshot_t;
+
+static bfs_err_t memory_read(bfs_bio_t *bio, bfs_blk_t block, void *buffer)
+{
+    memory_device_t *device = (memory_device_t *)bio;
+    device->reads++;
+    if (!buffer || block >= bio->block_count) return BFS_ERR_INVAL;
+    if (device->fail_read_at == device->reads) {
+        device->fail_read_at = 0;
+        return device->read_error;
+    }
+    memcpy(buffer, device->bytes + (size_t)block * bio->block_size,
+           bio->block_size); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+    return BFS_OK;
+}
+
+static bfs_err_t memory_write(bfs_bio_t *bio, bfs_blk_t block,
+                              const void *buffer)
+{
+    memory_device_t *device = (memory_device_t *)bio;
+    device->writes++;
+    if (!buffer || block >= bio->block_count) return BFS_ERR_INVAL;
+    if (device->track_settlement && device->observed_fs) {
+        if (device->observed_fs->freespace.settlement_active)
+            device->guarded_writes++;
+        else
+            device->unguarded_writes++;
+    }
+    if (device->fail_write_at == device->writes) {
+        device->fail_write_at = 0;
+        if (device->partial_write)
+            memcpy(device->bytes + (size_t)block * bio->block_size, buffer,
+                   bio->block_size / 2); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+        return device->write_error;
+    }
+    memcpy(device->bytes + (size_t)block * bio->block_size, buffer,
+           bio->block_size); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+    return BFS_OK;
+}
+
+static bfs_err_t memory_sync(bfs_bio_t *bio)
+{
+    memory_device_t *device = (memory_device_t *)bio;
+    device->syncs++;
+    if (device->track_settlement && device->observed_fs) {
+        if (device->observed_fs->freespace.settlement_active)
+            device->guarded_syncs++;
+        else
+            device->unguarded_syncs++;
+    }
+    if (device->fail_sync_at == device->syncs) {
+        device->fail_sync_at = 0;
+        return device->sync_error;
+    }
+    return BFS_OK;
+}
+
+static void memory_close(bfs_bio_t *bio) { (void)bio; }
+
+static const bfs_bio_ops_t memory_ops = {
+    .read_block = memory_read,
+    .write_block = memory_write,
+    .sync = memory_sync,
+    .close = memory_close,
+};
+
+static bool fixture_init(fixture_t *fixture, uint32_t block_size)
+{
+    memset(fixture, 0, sizeof(*fixture));
+    fixture->device.bytes = calloc(TEST_BLOCK_COUNT, block_size);
+    if (!fixture->device.bytes) return false;
+    fixture->device.bio.ops = &memory_ops;
+    fixture->device.bio.block_size = block_size;
+    fixture->device.bio.block_count = TEST_BLOCK_COUNT;
+    if (bfs_fs_format(&fixture->device.bio, "MetadataStock", 0) != BFS_OK ||
+        bfs_fs_mount(&fixture->fs, &fixture->device.bio) != BFS_OK)
+        return false;
+    fixture->device.observed_fs = &fixture->fs;
+    fixture->device.reads = 0;
+    fixture->device.writes = 0;
+    fixture->device.syncs = 0;
+    return fixture->fs.mounted && !fixture->fs.read_only &&
+           fixture->fs.freespace.owner == &fixture->fs &&
+           fixture->fs.freespace.sb == &fixture->fs.txn.sb_new &&
+           fixture->fs.freespace.committed_sb == &fixture->fs.txn.sb;
+}
+
+static void fixture_destroy(fixture_t *fixture)
+{
+    if (fixture->fs.mounted) bfs_fs_abandon(&fixture->fs);
+    free(fixture->device.bytes);
+    fixture->device.bytes = NULL;
+}
+
+static bool exact_mounted_wiring(const bfs_fs_t *fs)
+{
+    const bfs_freespace_t *space = &fs->freespace;
+    return fs->mounted && !fs->read_only && space->owner == fs &&
+           space->sb == &fs->txn.sb_new &&
+           space->committed_sb == &fs->txn.sb &&
+           space->mounted_state == &fs->mounted &&
+           space->snapshot_state == &fs->has_snapshots &&
+           space->readonly_state == &fs->read_only &&
+           space->recovery_state == &fs->recovery_error &&
+           space->tree.bio == fs->bio && fs->txn.bio == fs->bio &&
+           space->tree.alloc == &space->iface &&
+           space->iface.ctx == space &&
+           space->tree.height == 1 && space->tree.root != BFS_BLK_NULL &&
+           space->tree.txn_id_ptr == &fs->live_txn_id &&
+           fs->live_txn_id > bfs_be64(fs->txn.sb.txn_id);
+}
+
+static void take_snapshot(const bfs_fs_t *fs, allocator_snapshot_t *snapshot)
+{
+    memset(snapshot, 0, sizeof(*snapshot));
+    snapshot->working_sb = fs->txn.sb_new;
+    snapshot->committed_sb = fs->txn.sb;
+    memcpy(snapshot->reserve, fs->freespace.reserve,
+           sizeof(snapshot->reserve)); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+    memcpy(snapshot->pending, fs->pending_frees, sizeof(snapshot->pending)); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+    snapshot->reserve_count = fs->freespace.reserve_count;
+    snapshot->pending_count = fs->pending_count;
+    snapshot->root = fs->freespace.tree.root;
+    snapshot->height = fs->freespace.tree.height;
+    snapshot->total_free = fs->freespace.total_free;
+    snapshot->roving = fs->freespace.roving;
+    snapshot->live_txn_id = fs->live_txn_id;
+    snapshot->in_alloc = fs->freespace.in_alloc;
+    snapshot->free_sink_error = fs->freespace.tree.free_sink_err;
+    snapshot->recovery_error = fs->recovery_error;
+}
+
+static bool snapshot_matches(const bfs_fs_t *fs,
+                             const allocator_snapshot_t *snapshot)
+{
+    return memcmp(&fs->txn.sb_new, &snapshot->working_sb,
+                  sizeof(snapshot->working_sb)) == 0 &&
+           memcmp(&fs->txn.sb, &snapshot->committed_sb,
+                  sizeof(snapshot->committed_sb)) == 0 &&
+           memcmp(fs->freespace.reserve, snapshot->reserve,
+                  sizeof(snapshot->reserve)) == 0 &&
+           memcmp(fs->pending_frees, snapshot->pending,
+                  sizeof(snapshot->pending)) == 0 &&
+           fs->freespace.reserve_count == snapshot->reserve_count &&
+           fs->pending_count == snapshot->pending_count &&
+           fs->freespace.tree.root == snapshot->root &&
+           fs->freespace.tree.height == snapshot->height &&
+           fs->freespace.total_free == snapshot->total_free &&
+           fs->freespace.roving == snapshot->roving &&
+           fs->freespace.in_alloc == snapshot->in_alloc &&
+           fs->freespace.tree.free_sink_err == snapshot->free_sink_error &&
+           fs->recovery_error == snapshot->recovery_error;
+}
+
+static bool block_is_free(const bfs_fs_t *fs, bfs_blk_t block)
+{
+    uint32_t search = bfs_be32(block), key = 0, length = 0;
+    if (bfs_btree_search_floor((bfs_btree_t *)&fs->freespace.tree, &search,
+                               &key, &length) != BFS_OK)
+        return false;
+    uint32_t start = bfs_be32(key), count = bfs_be32(length);
+    return block >= start && block - start < count;
+}
+
+static bool current_or_committed_root(const bfs_fs_t *fs, bfs_blk_t block)
+{
+    const bfs_superblock_t *working = &fs->txn.sb_new;
+    const bfs_superblock_t *committed = &fs->txn.sb;
+    const bfs_blk_t roots[] = {
+        fs->freespace.tree.root,
+        fs->dir_tree.tree.root,
+        fs->inode_tree.root,
+        fs->refcount.tree.root,
+        bfs_be32(working->snapshot_tree_root),
+        bfs_be32(working->extent_tree_root),
+        bfs_be32(committed->dir_tree_root),
+        bfs_be32(committed->inode_tree_root),
+        bfs_be32(committed->free_tree_root),
+        bfs_be32(committed->refcount_tree_root),
+        bfs_be32(committed->snapshot_tree_root),
+        bfs_be32(committed->extent_tree_root),
+    };
+    for (uint32_t i = 0; i < sizeof(roots) / sizeof(roots[0]); i++)
+        if (block == roots[i]) return true;
+    return block == (bfs_blk_t)(bfs_sb_backup_offset(working) /
+                                fs->bio->block_size) ||
+           block == (bfs_blk_t)(bfs_sb_backup_offset(committed) /
+                                fs->bio->block_size);
+}
+
+static bool owned_reserve_block(const bfs_fs_t *fs, bfs_blk_t block)
+{
+    uint32_t active = bfs_be32(fs->txn.sb_new.emergency_count);
+    if (block == BFS_BLK_NULL || block >= fs->bio->block_count ||
+        block < bfs_data_start_block(fs->bio->block_size) ||
+        active > BFS_EMERGENCY_POOL_SIZE || block_is_free(fs, block) ||
+        current_or_committed_root(fs, block))
+        return false;
+    for (uint32_t i = 0; i < active; i++)
+        if (block == bfs_be32(fs->txn.sb_new.emergency_pool[i]))
+            return false;
+    return true;
+}
+
+/* A drawn metadata spare must be ordinary, including no inactive historical
+ * emergency-slot provenance. Recursive reserve prefixes may retain inactive
+ * pool-origin scratch under their existing ownership contract. */
+static bool ordinary_metadata_block(const bfs_fs_t *fs, bfs_blk_t block)
+{
+    if (!owned_reserve_block(fs, block)) return false;
+    for (uint32_t i = 0; i < BFS_EMERGENCY_POOL_SIZE; i++)
+        if (block == bfs_be32(fs->txn.sb_new.emergency_pool[i])) return false;
+    return true;
+}
+
+static bool reserve_unique(const bfs_fs_t *fs)
+{
+    if (fs->freespace.reserve_count > BFS_ALLOC_RESERVE_SIZE) return false;
+    for (uint32_t i = 0; i < fs->freespace.reserve_count; i++) {
+        if (!owned_reserve_block(fs, fs->freespace.reserve[i])) return false;
+        for (uint32_t j = 0; j < i; j++)
+            if (fs->freespace.reserve[i] == fs->freespace.reserve[j])
+                return false;
+    }
+    return true;
+}
+
+typedef struct {
+    bfs_blk_t blocks[BFS_ALLOC_RESERVE_SIZE + BFS_EMERGENCY_POOL_SIZE];
+    uint32_t count;
+} allocator_ownership_t;
+
+static bool capture_allocator_ownership(const bfs_fs_t *fs,
+                                       allocator_ownership_t *ownership)
+{
+    memset(ownership, 0, sizeof(*ownership));
+    uint32_t active = bfs_be32(fs->txn.sb_new.emergency_count);
+    if (fs->freespace.reserve_count > BFS_ALLOC_RESERVE_SIZE ||
+        active > BFS_EMERGENCY_POOL_SIZE)
+        return false;
+    for (uint32_t i = 0; i < fs->freespace.reserve_count + active; i++) {
+        bfs_blk_t block = i < fs->freespace.reserve_count
+            ? fs->freespace.reserve[i]
+            : bfs_be32(fs->txn.sb_new.emergency_pool[
+                  i - fs->freespace.reserve_count]);
+        if (block == BFS_BLK_NULL) return false;
+        for (uint32_t j = 0; j < ownership->count; j++)
+            if (ownership->blocks[j] == block) return false;
+        ownership->blocks[ownership->count++] = block;
+    }
+    return true;
+}
+
+static bool same_allocator_ownership(const allocator_ownership_t *before,
+                                     const allocator_ownership_t *after)
+{
+    if (before->count != after->count) return false;
+    for (uint32_t i = 0; i < before->count; i++) {
+        bool found = false;
+        for (uint32_t j = 0; j < after->count; j++)
+            if (before->blocks[i] == after->blocks[j]) found = true;
+        if (!found) return false;
+    }
+    return true;
+}
+
+static void test_first_mounted_stock_draw_keeps_full_recursive_floor(void)
+{
+    const uint32_t sizes[] = { 1024u, 4096u };
+    for (uint32_t si = 0; si < sizeof(sizes) / sizeof(sizes[0]); si++) {
+        fixture_t fixture;
+        TEST_ASSERT(fixture_init(&fixture, sizes[si]));
+        TEST_ASSERT(exact_mounted_wiring(&fixture.fs));
+        TEST_ASSERT_EQ(fixture.fs.freespace.reserve_count, 0);
+        TEST_ASSERT_EQ(fixture.fs.freespace.tree.height, 1);
+
+        bfs_lock_write(&fixture.fs.lock);
+        uint32_t free_before = fixture.fs.freespace.total_free;
+        bfs_blk_t roving_before = fixture.fs.freespace.roving;
+        bfs_blk_t block = fixture.fs.freespace.iface.alloc(
+            &fixture.fs.freespace.iface);
+        TEST_ASSERT(block != BFS_BLK_NULL);
+        TEST_ASSERT(ordinary_metadata_block(&fixture.fs, block));
+        for (uint32_t i = 0; i < fixture.fs.freespace.reserve_count; i++)
+            TEST_ASSERT(block != fixture.fs.freespace.reserve[i]);
+        TEST_ASSERT(fixture.fs.freespace.reserve_count > HEIGHT_ONE_FLOOR);
+        TEST_ASSERT(fixture.fs.freespace.reserve_count <=
+                    HEIGHT_ONE_FLOOR + STOCK_EXTRA - 1);
+        TEST_ASSERT(fixture.fs.freespace.reserve_count >= HEIGHT_ONE_FLOOR);
+        TEST_ASSERT_EQ(fixture.fs.freespace.total_free,
+                       free_before - (fixture.fs.freespace.reserve_count + 1));
+        TEST_ASSERT_EQ(fixture.fs.freespace.roving, roving_before);
+        TEST_ASSERT(reserve_unique(&fixture.fs));
+
+        bfs_blk_t allocated[BFS_ALLOC_RESERVE_SIZE];
+        uint32_t allocated_count = 0;
+        allocated[allocated_count++] = block;
+        uint32_t writes_after_seed = fixture.device.writes;
+        bfs_blk_t root_after_seed = fixture.fs.freespace.tree.root;
+        uint32_t free_after_seed = fixture.fs.freespace.total_free;
+        bfs_blk_t roving_after_seed = fixture.fs.freespace.roving;
+        uint32_t pending_after_seed = fixture.fs.pending_count;
+        while (fixture.fs.freespace.reserve_count > HEIGHT_ONE_FLOOR) {
+            bfs_blk_t next = fixture.fs.freespace.iface.alloc(
+                &fixture.fs.freespace.iface);
+            TEST_ASSERT(next != BFS_BLK_NULL);
+            TEST_ASSERT(ordinary_metadata_block(&fixture.fs, next));
+            for (uint32_t i = 0; i < allocated_count; i++)
+                TEST_ASSERT(next != allocated[i]);
+            allocated[allocated_count++] = next;
+            TEST_ASSERT(reserve_unique(&fixture.fs));
+        }
+        TEST_ASSERT_EQ(fixture.fs.freespace.reserve_count, HEIGHT_ONE_FLOOR);
+        TEST_ASSERT_EQ(fixture.device.writes, writes_after_seed);
+        TEST_ASSERT_EQ(fixture.fs.freespace.tree.root, root_after_seed);
+        TEST_ASSERT_EQ(fixture.fs.freespace.total_free, free_after_seed);
+        TEST_ASSERT_EQ(fixture.fs.freespace.roving, roving_after_seed);
+        TEST_ASSERT_EQ(fixture.fs.pending_count, pending_after_seed);
+        TEST_ASSERT_EQ(allocated_count,
+                       1 + (HEIGHT_ONE_FLOOR + STOCK_EXTRA - 1 -
+                            HEIGHT_ONE_FLOOR));
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+    }
+}
+
+static void test_real_candidate_stash_and_reuse_is_write_free(void)
