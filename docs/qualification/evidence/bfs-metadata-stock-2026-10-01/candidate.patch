+static void test_commit_settlement_guard_is_restored_on_success_and_error(void)
+{
+    fixture_t fixture;
+    TEST_ASSERT(fixture_init(&fixture, 1024u));
+    uint32_t ino = 0;
+    TEST_ASSERT_EQ(bfs_fs_create_file(&fixture.fs, BFS_ROOT_INO, "one", 3,
+                                      &ino), BFS_OK);
+    TEST_ASSERT(ino != 0);
+
+    fixture.device.writes = 0;
+    fixture.device.syncs = 0;
+    fixture.device.guarded_writes = 0;
+    fixture.device.unguarded_writes = 0;
+    fixture.device.guarded_syncs = 0;
+    fixture.device.unguarded_syncs = 0;
+    fixture.device.track_settlement = true;
+    TEST_ASSERT_EQ(bfs_fs_sync(&fixture.fs), BFS_OK);
+    TEST_ASSERT(!fixture.fs.freespace.settlement_active);
+    TEST_ASSERT(fixture.device.writes > 0 && fixture.device.syncs > 0);
+    TEST_ASSERT_EQ(fixture.device.guarded_writes, fixture.device.writes);
+    TEST_ASSERT_EQ(fixture.device.unguarded_writes, 0);
+    TEST_ASSERT_EQ(fixture.device.guarded_syncs, fixture.device.syncs);
+    TEST_ASSERT_EQ(fixture.device.unguarded_syncs, 0);
+
+    TEST_ASSERT_EQ(bfs_fs_create_file(&fixture.fs, BFS_ROOT_INO, "two", 3,
+                                      &ino), BFS_OK);
+    fixture.device.writes = 0;
+    fixture.device.syncs = 0;
+    fixture.device.guarded_writes = 0;
+    fixture.device.unguarded_writes = 0;
+    fixture.device.guarded_syncs = 0;
+    fixture.device.unguarded_syncs = 0;
+    fixture.device.fail_sync_at = 1;
+    fixture.device.sync_error = BFS_ERR_IO;
+    TEST_ASSERT_EQ(bfs_fs_sync(&fixture.fs), BFS_ERR_IO);
+    TEST_ASSERT(!fixture.fs.freespace.settlement_active);
+    TEST_ASSERT(fixture.device.guarded_syncs > 0);
+    TEST_ASSERT_EQ(fixture.device.guarded_writes, fixture.device.writes);
+    TEST_ASSERT_EQ(fixture.device.unguarded_writes, 0);
+    TEST_ASSERT_EQ(fixture.device.unguarded_syncs, 0);
+    TEST_ASSERT_EQ(fixture.fs.recovery_error, BFS_ERR_IO);
+    fixture.device.track_settlement = false;
+    fixture_destroy(&fixture);
+}
