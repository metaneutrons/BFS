+typedef struct {
+    bfs_blk_t starts[256];
+    uint32_t lengths[256];
+    uint32_t count;
+    bool overflow;
+} extent_list_t;
+
+static bool collect_extent(const void *key, const void *value, void *ctx)
+{
+    extent_list_t *list = (extent_list_t *)ctx;
+    if (list->count == sizeof(list->starts) / sizeof(list->starts[0])) {
+        list->overflow = true;
+        return false;
+    }
+    list->starts[list->count] = bfs_load_be32(key);
+    list->lengths[list->count] = bfs_load_be32(value);
+    list->count++;
+    return true;
+}
+
+static bool read_extents(bfs_fs_t *fs, extent_list_t *list)
+{
+    memset(list, 0, sizeof(*list));
+    return bfs_btree_scan(&fs->freespace.tree, NULL, collect_extent, list) ==
+               BFS_OK && !list->overflow;
+}
+
+static void test_refill_prefers_a_complete_lower_run_over_short_high_tail(void)
+{
+    fixture_t fixture;
+    TEST_ASSERT(fixture_init(&fixture, 1024u));
+    bfs_lock_write(&fixture.fs.lock);
+    bfs_blk_t carved[24];
+    for (uint32_t i = 0; i < sizeof(carved) / sizeof(carved[0]); i++) {
+        carved[i] = bfs_freespace_alloc(&fixture.fs.freespace, 1);
+        TEST_ASSERT(carved[i] != BFS_BLK_NULL);
+        if (i > 0) TEST_ASSERT_EQ(carved[i - 1], carved[i] + 1);
+    }
+    TEST_ASSERT_EQ(bfs_freespace_free(&fixture.fs.freespace, carved[7], 8),
+                   BFS_OK);
+    extent_list_t before;
+    TEST_ASSERT(read_extents(&fixture.fs, &before));
+    TEST_ASSERT(before.count >= 2);
+    uint32_t selected = before.count;
+    uint32_t short_tail = before.count;
+    for (uint32_t i = 0; i < before.count; i++) {
+        if (selected == before.count &&
+            before.lengths[i] >= HEIGHT_ONE_FLOOR + STOCK_EXTRA)
+            selected = i;
+        if (before.starts[i] == carved[7] && before.lengths[i] == 8)
+            short_tail = i;
+    }
+    TEST_ASSERT(selected < before.count);
+    TEST_ASSERT(short_tail < before.count);
+    TEST_ASSERT(selected != short_tail);
+    uint32_t low_start = before.starts[selected];
+    uint32_t low_length = before.lengths[selected];
+    uint32_t short_start = before.starts[short_tail];
+    uint32_t short_length = before.lengths[short_tail];
+    TEST_ASSERT(low_length >= HEIGHT_ONE_FLOOR + STOCK_EXTRA);
+    TEST_ASSERT(short_length < HEIGHT_ONE_FLOOR + STOCK_EXTRA);
+
+    uint32_t free_before = fixture.fs.freespace.total_free;
+    uint32_t reserve_before = fixture.fs.freespace.reserve_count;
+    TEST_ASSERT_EQ(reserve_before, HEIGHT_ONE_FLOOR);
+    bfs_blk_t block = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    TEST_ASSERT(block != BFS_BLK_NULL);
+    TEST_ASSERT_EQ(fixture.fs.freespace.reserve_count,
+                   reserve_before + STOCK_EXTRA - 1);
+    TEST_ASSERT_EQ(fixture.fs.freespace.total_free,
+                   free_before - STOCK_EXTRA);
+    TEST_ASSERT(block >= low_start + low_length - STOCK_EXTRA &&
+                block < low_start + low_length);
+
+    extent_list_t after;
+    TEST_ASSERT(read_extents(&fixture.fs, &after));
+    TEST_ASSERT_EQ(after.count, before.count);
+    for (uint32_t i = 0; i < before.count; i++) {
+        TEST_ASSERT_EQ(after.starts[i], before.starts[i]);
+        TEST_ASSERT_EQ(after.lengths[i], before.lengths[i] -
+                       (i == selected ? STOCK_EXTRA : 0));
+    }
+    TEST_ASSERT_EQ(after.starts[short_tail], short_start);
+    TEST_ASSERT_EQ(after.lengths[short_tail], short_length);
+    TEST_ASSERT(reserve_unique(&fixture.fs));
+    bfs_lock_unlock(&fixture.fs.lock);
+    fixture_destroy(&fixture);
+}
+
+static bfs_blk_t first_free_block(bfs_fs_t *fs)
+{
+    extent_list_t extents;
+    if (!read_extents(fs, &extents) || extents.count == 0)
+        return BFS_BLK_NULL;
+    return extents.starts[0];
+}
+
+static bool rejected_candidate_is_unchanged(uint32_t mode)
+{
+    fixture_t fixture;
+    if (!fixture_init(&fixture, 1024u)) return false;
+    if (mode == 0 || mode == 5) {
+        uint32_t ino = 0;
+        if (bfs_fs_create_file(&fixture.fs, BFS_ROOT_INO, "root-change", 11,
+                               &ino) != BFS_OK || ino == 0 ||
+            fixture.fs.dir_tree.tree.root ==
+                bfs_be32(fixture.fs.txn.sb.dir_tree_root)) {
+            fixture_destroy(&fixture);
+            return false;
+        }
+    }
+    bfs_lock_write(&fixture.fs.lock);
+    bfs_blk_t seed = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    if (seed == BFS_BLK_NULL ||
+        fixture.fs.freespace.reserve_count <= HEIGHT_ONE_FLOOR) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+    uint32_t candidate_index = fixture.fs.freespace.reserve_count - 1;
+    bfs_blk_t invalid;
+    if (mode == 0) invalid = fixture.fs.dir_tree.tree.root;
+    else if (mode == 1)
+        invalid = (bfs_blk_t)(bfs_sb_backup_offset(&fixture.fs.txn.sb_new) /
+                              fixture.fs.bio->block_size);
+    else if (mode == 2) invalid = first_free_block(&fixture.fs);
+    else if (mode == 3)
+        invalid = bfs_be32(fixture.fs.txn.sb_new.emergency_pool[0]);
+    else if (mode == 4)
+        invalid = fixture.fs.freespace.reserve[candidate_index - 1];
+    else invalid = bfs_be32(fixture.fs.txn.sb.dir_tree_root);
+    if (invalid == BFS_BLK_NULL) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+    fixture.fs.freespace.reserve[candidate_index] = invalid;
+    allocator_snapshot_t snapshot;
+    take_snapshot(&fixture.fs, &snapshot);
+    uint32_t writes_before = fixture.device.writes;
+    bfs_blk_t result = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    bfs_err_t expected = (mode == 2 || mode == 3 || mode == 4)
+        ? BFS_ERR_EXISTS : BFS_ERR_CORRUPT;
+    bool ok = result == BFS_BLK_NULL &&
+              fixture.fs.freespace.iface.error(&fixture.fs.freespace.iface) ==
+                  expected && fixture.device.writes == writes_before &&
+              snapshot_matches(&fixture.fs, &snapshot);
+    bfs_lock_unlock(&fixture.fs.lock);
+    fixture_destroy(&fixture);
+    return ok;
+}
+
+static void test_live_root_backup_and_free_overlaps_fail_before_writes(void)
+{
+    for (uint32_t mode = 0; mode < 6; mode++)
+        TEST_ASSERT(rejected_candidate_is_unchanged(mode));
+}
+
+static bool wrapped_hash_collision_duplicate_is_unchanged(void)
+{
+    fixture_t fixture;
+    if (!fixture_init(&fixture, 1024u)) return false;
+    bfs_lock_write(&fixture.fs.lock);
+    bfs_blk_t stock = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    if (stock == BFS_BLK_NULL ||
+        fixture.fs.freespace.reserve_count < HEIGHT_ONE_FLOOR + 3) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+
+    /* Own a real contiguous ordinary run, then arrange a 255-bucket cluster:
+     * y inserts at slot 255, x wraps to slot 0, and duplicate x must be found
+     * after probing across the table boundary. */
+    bfs_blk_t run = bfs_freespace_alloc(&fixture.fs.freespace, 512);
+    if (run == BFS_BLK_NULL) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+    uint32_t offset = (255u - (run % 256u)) % 256u;
+    bfs_blk_t x = run + offset;
+    bfs_blk_t y = x + 256u;
+    if (y >= run + 512u || !ordinary_metadata_block(&fixture.fs, x) ||
+        !ordinary_metadata_block(&fixture.fs, y)) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+    uint32_t first = HEIGHT_ONE_FLOOR;
+    fixture.fs.freespace.reserve[first] = y;
+    fixture.fs.freespace.reserve[first + 1] = x;
+    fixture.fs.freespace.reserve[first + 2] = x;
+    allocator_snapshot_t snapshot;
+    take_snapshot(&fixture.fs, &snapshot);
+    uint32_t writes_before = fixture.device.writes;
+    bfs_blk_t result = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    bool ok = result == BFS_BLK_NULL &&
+        fixture.fs.freespace.iface.error(&fixture.fs.freespace.iface) ==
+            BFS_ERR_EXISTS && fixture.device.writes == writes_before &&
+        snapshot_matches(&fixture.fs, &snapshot);
+    bfs_lock_unlock(&fixture.fs.lock);
+    fixture_destroy(&fixture);
+    return ok;
+}
+
+static void test_stock_hash_duplicate_detection_wraps(void)
+{
+    TEST_ASSERT(wrapped_hash_collision_duplicate_is_unchanged());
+}
+
+static bool failed_refill_propagates(bfs_err_t injected_error,
+                                     bool partial_write)
+{
+    fixture_t fixture;
+    if (!fixture_init(&fixture, 1024u)) return false;
+    bfs_lock_write(&fixture.fs.lock);
+    allocator_snapshot_t before;
+    take_snapshot(&fixture.fs, &before);
+    allocator_ownership_t ownership_before;
+    if (partial_write &&
+        !capture_allocator_ownership(&fixture.fs, &ownership_before)) {
+        bfs_lock_unlock(&fixture.fs.lock);
+        fixture_destroy(&fixture);
+        return false;
+    }
+    fixture.device.fail_read_at = fixture.device.reads + 1;
+    fixture.device.read_error = injected_error;
+    if (partial_write) {
+        fixture.device.fail_read_at = 0;
+        fixture.device.fail_write_at = fixture.device.writes + 1;
+        fixture.device.write_error = injected_error;
+        fixture.device.partial_write = true;
+    }
+    uint32_t writes_before = fixture.device.writes;
+    bfs_blk_t result = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    bfs_err_t last_error = fixture.fs.freespace.iface.error(
+        &fixture.fs.freespace.iface);
+    bool ok = result == BFS_BLK_NULL && last_error == injected_error;
+    if (partial_write) {
+        ok = ok && fixture.device.writes == writes_before + 1 &&
+             fixture.fs.freespace.tree.root == before.root &&
+             fixture.fs.freespace.total_free == before.total_free &&
+             fixture.fs.pending_count == before.pending_count &&
+             memcmp(fixture.fs.pending_frees, before.pending,
+                    sizeof(before.pending)) == 0 &&
+             fixture.fs.live_txn_id == before.live_txn_id &&
+             fixture.fs.txn.sb_new.txn_id == before.working_sb.txn_id &&
+             fixture.fs.txn.sb.txn_id == before.committed_sb.txn_id &&
+             fixture.fs.txn.sb_new.dir_tree_root ==
+                 before.working_sb.dir_tree_root &&
+             fixture.fs.txn.sb_new.inode_tree_root ==
+                 before.working_sb.inode_tree_root &&
+             fixture.fs.txn.sb_new.free_tree_root ==
+                 before.working_sb.free_tree_root &&
+             fixture.fs.txn.sb_new.refcount_tree_root ==
+                 before.working_sb.refcount_tree_root &&
+             fixture.fs.txn.sb_new.snapshot_tree_root ==
+                 before.working_sb.snapshot_tree_root &&
+             fixture.fs.txn.sb_new.extent_tree_root ==
+                 before.working_sb.extent_tree_root &&
+             fixture.fs.txn.sb.dir_tree_root ==
+                 before.committed_sb.dir_tree_root &&
+             fixture.fs.txn.sb.inode_tree_root ==
+                 before.committed_sb.inode_tree_root &&
+             fixture.fs.txn.sb.free_tree_root ==
+                 before.committed_sb.free_tree_root &&
+             fixture.fs.txn.sb.refcount_tree_root ==
+                 before.committed_sb.refcount_tree_root &&
+             fixture.fs.txn.sb.snapshot_tree_root ==
+                 before.committed_sb.snapshot_tree_root &&
+             fixture.fs.txn.sb.extent_tree_root ==
+                 before.committed_sb.extent_tree_root;
+        allocator_ownership_t ownership_after;
+        ok = ok && capture_allocator_ownership(&fixture.fs,
+                                                &ownership_after) &&
+             same_allocator_ownership(&ownership_before, &ownership_after);
+    } else {
+        ok = ok && fixture.device.writes == writes_before &&
+             snapshot_matches(&fixture.fs, &before);
+    }
+    bfs_lock_unlock(&fixture.fs.lock);
+    fixture_destroy(&fixture);
+    return ok;
+}
+
+static void test_refill_read_and_partial_write_errors_never_fall_back(void)
+{
+    TEST_ASSERT(failed_refill_propagates(BFS_ERR_UNSUPPORTED, false));
+    TEST_ASSERT(failed_refill_propagates(BFS_ERR_IO, true));
+}
+
+static bool first_request_uses_legacy_floor_when_ineligible(bool snapshots)
+{
+    fixture_t fixture;
+    if (!fixture_init(&fixture, 1024u)) return false;
+    if (snapshots) {
+        fixture.fs.options |= BFS_OPT_SNAPSHOTS;
+        fixture.fs.txn.sb_new.options = bfs_be32(
+            bfs_be32(fixture.fs.txn.sb_new.options) | BFS_OPT_SNAPSHOTS);
+    } else {
+        fixture.fs.has_snapshots = true;
+    }
+    bfs_lock_write(&fixture.fs.lock);
+    uint32_t free_before = fixture.fs.freespace.total_free;
+    bfs_blk_t block = fixture.fs.freespace.iface.alloc(
+        &fixture.fs.freespace.iface);
+    bool ok = block != BFS_BLK_NULL &&
+              fixture.fs.freespace.reserve_count == HEIGHT_ONE_FLOOR &&
+              fixture.fs.freespace.total_free == free_before -
+                  (HEIGHT_ONE_FLOOR + 1);
+    bfs_lock_unlock(&fixture.fs.lock);
+    fixture_destroy(&fixture);
+    return ok;
+}
+
+static void test_snapshot_transitions_decline_expanded_stock(void)
+{
+    TEST_ASSERT(first_request_uses_legacy_floor_when_ineligible(false));
+    TEST_ASSERT(first_request_uses_legacy_floor_when_ineligible(true));
+}
