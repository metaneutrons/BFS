diff --git a/src/amiga/memcpy_68k.s b/src/amiga/memcpy_68k.s
index 181bfc2..123dc3d 100644
--- a/src/amiga/memcpy_68k.s
+++ b/src/amiga/memcpy_68k.s
@@ -18,6 +18,32 @@
 |   Returns dst in d0.
 
 _memcpy:
+        | Tiny copies use caller-saved registers without a save frame.
+        | The retained 44-byte path below is otherwise unchanged.
+        move.l  12(sp),d0               | unsigned len, original stack
+        cmp.l   #44,d0
+        bcc.s   .Lmc_large
+        move.l  4(sp),a0                | dst
+        move.l  8(sp),a1                | src
+        move.l  d0,d1
+        lsr.l   #2,d1
+        beq.s   .Lmc_short_bytes
+        subq.l  #1,d1
+.Lmc_short_l4:
+        move.l  (a1)+,(a0)+
+        dbra    d1,.Lmc_short_l4
+.Lmc_short_bytes:
+        andi.l  #3,d0
+        beq.s   .Lmc_short_done
+        subq.l  #1,d0
+.Lmc_short_b1:
+        move.b  (a1)+,(a0)+
+        dbra    d0,.Lmc_short_b1
+.Lmc_short_done:
+        move.l  4(sp),d0                | return original dst, SP unchanged
+        rts
+
+.Lmc_large:
         movem.l d2-d7/a2-a6,-(sp)      | save 11 regs (+44)
         move.l  48(sp),a0               | dst
         move.l  52(sp),a1               | src
