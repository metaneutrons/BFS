+/* The packets that can change the volume: the ones a snapshot refuses, a
+ * close (it stamps the inode), a media change and the 64-bit resize. */
+static bool PacketMayChangeVolume(LONG type)
+{
+    if (SnapshotRejectsPacket(type)) return true;
+    switch (type) {
+    case ACTION_END:
+    case ACTION_INHIBIT:
+    case ACTION_DIE:
+    case BFS_ACTION_CHANGE_FILE_SIZE64:
+        return true;
+    default:
+        return false;
+    }
+}
