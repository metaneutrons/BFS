+                                    &ec->skip_count, false);
             if (err != BFS_OK) return err;
         }
+        bool more = b->full || b->count == EXALL_BATCH;
+        if (!cached) {
+            if (ec->type >= ED_SIZE) {
+                err = ExAllReadInodes(h, b);
+                if (err != BFS_OK) return err;
