+/* ExAll result cache bound (docs/plans/bfs-exall-result-cache-v1.md): one
+ * array of 1,024 entries holding the last unfiltered pass over one directory
+ * with the inode copies it read. A measuring device for an upper bound, never
+ * a release artifact. */
+#define EXALL_CACHE_CAP 1024u
+#define EXALL_CACHE_NAMES 16384u
+
+typedef struct {
+    uint32_t ino;
+    uint32_t type;
+    bfs_dir_pos_t pos;
+    uint16_t name_offset;
+    uint8_t name_len;
+    bfs_inode_t inode;
+} exall_cache_entry_t;
+
+struct exall_cache {
+    bool valid;            /* a complete pass of dir_ino at stamp is recorded */
+    bool recording;        /* a pass of rec_dir at rec_stamp is being recorded */
+    uint32_t dir_ino;
+    uint32_t stamp;
+    uint32_t count;
+    uint32_t rec_dir;
+    uint32_t rec_stamp;
+    uint32_t rec_count;
+    uint32_t names_used;
+    exall_cache_entry_t entries[EXALL_CACHE_CAP];
+    char names[EXALL_CACHE_NAMES];
+};
+typedef struct exall_cache exall_cache_t;
