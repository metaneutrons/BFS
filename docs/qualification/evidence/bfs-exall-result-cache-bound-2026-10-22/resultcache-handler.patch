+static exall_cache_t *ExAllCacheGet(struct bfs_handler *h)
+{
+    if (!h->exall_cache) {
+        h->exall_cache = (exall_cache_t *)AllocVec(sizeof(*h->exall_cache), MEMF_ANY);
+        if (h->exall_cache) {
+            h->exall_cache->valid = false;
+            h->exall_cache->recording = false;
+        }
+    }
+    return h->exall_cache;
+}
+
+static bool ExAllCacheHit(const struct bfs_handler *h, const exall_cache_t *c,
+                          const bfs_lock_t *lk)
+{
+    return c->valid && c->dir_ino == lk->ino && c->stamp == h->volume_changes;
+}
+
+/* Gather the next batch from the cache with the callback the scan uses, so
+ * that pattern matching and the room check are the same. */
+static void ExAllGatherCached(exall_batch_t *b, const exall_cache_t *c, uint32_t position)
+{
+    b->ec->skip_count = 0;
+    if (position > c->count) position = c->count;
+    b->cached = c->entries + position;
+    for (uint32_t i = position; i < c->count; i++) {
+        const exall_cache_entry_t *e = &c->entries[i];
+        if (!exall_gather_cb(c->names + e->name_offset, e->name_len, e->ino, e->type,
+                             &e->pos, b))
+            break;
+    }
+}
+
+/* A pass from the start that reads inodes for every entry starts a recording. */
+static void ExAllCacheBegin(const struct bfs_handler *h, exall_cache_t *c,
+                            const bfs_lock_t *lk, const exall_optimized_ctx_t *ec)
+{
+    c->valid = false;
+    c->recording = ec->type >= ED_SIZE && !ec->eac->eac_MatchString;
+    c->rec_dir = lk->ino;
+    c->rec_stamp = h->volume_changes;
+    c->rec_count = 0;
+    c->names_used = 0;
+}
+
+/* Record the batch gathered at position first, with its inode copies. Any
+ * change, gap, or full array ends the recording. */
+static void ExAllCacheRecord(const struct bfs_handler *h, exall_cache_t *c,
+                             const bfs_lock_t *lk, const exall_batch_t *b, uint32_t first)
+{
+    if (!c->recording) return;
+    if (c->rec_dir != lk->ino || c->rec_stamp != h->volume_changes ||
+        first > c->rec_count || b->ec->type < ED_SIZE || b->ec->eac->eac_MatchString) {
+        c->recording = false;
+        return;
+    }
+    if (first < c->rec_count) { /* entries that were gathered but not written */
+        c->names_used = c->entries[first].name_offset;
+        c->rec_count = first;
+    }
+    if (c->rec_count + b->count > EXALL_CACHE_CAP) {
+        c->recording = false;
+        return;
+    }
+    for (uint32_t i = 0; i < b->count; i++) {
+        const exall_pending_t *p = &b->entries[i];
+        if (!p->matched || b->results[p->read_index] != BFS_OK ||
+            c->names_used + p->name_len > EXALL_CACHE_NAMES) {
+            c->recording = false;
+            return;
+        }
+        exall_cache_entry_t *e = &c->entries[c->rec_count + i];
+        e->ino = p->ino;
+        e->type = p->type;
+        e->pos = p->pos;
+        e->name_offset = (uint16_t)c->names_used;
+        e->name_len = p->name_len;
+        memcpy(c->names + c->names_used, b->names + p->name_offset, p->name_len);
+        c->names_used += p->name_len;
+        e->inode = b->inodes[p->read_index];
+    }
+    c->rec_count += b->count;
+}
+
+/* The scan reached the end of the directory and every entry was written. */
+static void ExAllCacheComplete(const struct bfs_handler *h, exall_cache_t *c,
+                               const bfs_lock_t *lk)
+{
+    if (!c->recording || c->rec_dir != lk->ino || c->rec_stamp != h->volume_changes) return;
+    c->recording = false;
+    c->valid = true;
+    c->dir_ino = c->rec_dir;
+    c->stamp = c->rec_stamp;
+    c->count = c->rec_count;
+}
