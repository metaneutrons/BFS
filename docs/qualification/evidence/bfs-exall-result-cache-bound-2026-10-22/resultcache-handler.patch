         }
-        if (!more) return BFS_OK;
+        if (!more) {
+            if (cache && !cached) ExAllCacheComplete(h, cache, lk);
+            return BFS_OK;
+        }
         /* The next batch resumes after the entry consumed last. */
         CursorRemember(lk, ec->position, &ec->last, false);
     }
