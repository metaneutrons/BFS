+/* SPDX-License-Identifier: MPL-2.0 */
+/* Focused tests for scan-only cache admission. */
+
+#include "test_harness.h"
+#include "bfs_cache.h"
+#include "bfs_dir.h"
+#include "bfs_btree_internal.h"
+
+#define BLOCK_SIZE BFS_MIN_BLOCK_SIZE
+#define BLOCK_COUNT 64
+
+typedef struct {
+    bfs_bio_t bio;
+    uint8_t blocks[BLOCK_COUNT][BLOCK_SIZE];
+    uint32_t reads;
+    uint32_t writes;
+    bool fail_read;
+    bool fail_write;
+} scan_memory_bio_t;
+
+static bfs_err_t scan_memory_read(bfs_bio_t *bio, bfs_blk_t block, void *buffer)
+{
+    scan_memory_bio_t *memory = (scan_memory_bio_t *)bio;
+    if (block >= bio->block_count) return BFS_ERR_INVAL;
+    memory->reads++;
+    if (memory->fail_read) return BFS_ERR_IO;
+    memcpy(buffer, memory->blocks[block], bio->block_size);
+    return BFS_OK;
+}
+
+static bfs_err_t scan_memory_write(bfs_bio_t *bio, bfs_blk_t block,
+                                   const void *buffer)
+{
+    scan_memory_bio_t *memory = (scan_memory_bio_t *)bio;
+    if (block >= bio->block_count) return BFS_ERR_INVAL;
+    memory->writes++;
+    if (memory->fail_write) return BFS_ERR_IO;
+    memcpy(memory->blocks[block], buffer, bio->block_size);
+    return BFS_OK;
+}
+
+static bfs_err_t scan_memory_sync(bfs_bio_t *bio)
+{
+    (void)bio;
+    return BFS_OK;
+}
+
+static const bfs_bio_ops_t scan_memory_ops = {
+    .read_block = scan_memory_read,
+    .write_block = scan_memory_write,
+    .sync = scan_memory_sync,
+};
+
+static const bfs_bio_ops_t empty_ops = {0};
+
+static void scan_memory_init(scan_memory_bio_t *memory)
+{
+    memset(memory, 0, sizeof(*memory));
+    memory->bio.ops = &scan_memory_ops;
+    memory->bio.block_size = BLOCK_SIZE;
+    memory->bio.block_count = BLOCK_COUNT;
+    for (uint32_t block = 0; block < BLOCK_COUNT; block++)
+        memset(memory->blocks[block], (int)(block + 1), BLOCK_SIZE);
+}
+
+static uint32_t find_resident(const bfs_cache_t *cache, bfs_blk_t block)
+{
+    for (uint32_t slot = 0; slot < cache->num_slots; slot++)
+        if (cache->slots[slot].blk == block) return slot;
+    return cache->num_slots;
+}
+
+static bfs_err_t finish_node(const void *layout, uint32_t block_size,
+                             uint8_t *buffer)
+{
+    (void)layout;
+    (void)block_size;
+    (void)buffer;
+    return BFS_OK;
+}
+
+static void test_bio_scan_wrapper_fallback_and_invalid_arguments(void)
+{
+    scan_memory_bio_t memory;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&memory.bio, 4, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[4], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 1);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&memory.bio, 5, result, false), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[5], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 2);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(NULL, 0, result, true), BFS_ERR_INVAL);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&memory.bio, 0, NULL, true), BFS_ERR_INVAL);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&memory.bio, BLOCK_COUNT, result, true),
+                   BFS_ERR_INVAL);
+    bfs_bio_t no_ops = {.ops = NULL, .block_size = BLOCK_SIZE,
+                        .block_count = BLOCK_COUNT};
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&no_ops, 0, result, true), BFS_ERR_INVAL);
+    bfs_bio_t no_read = {.ops = &empty_ops, .block_size = BLOCK_SIZE,
+                         .block_count = BLOCK_COUNT};
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&no_read, 0, result, true), BFS_ERR_INVAL);
+    TEST_ASSERT_EQ(memory.reads, 2);
+}
+
+static void test_scan_misses_require_two_reuses_then_hit(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    uint64_t epoch = cache.mutation_epoch;
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 8, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[8], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, 8), cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    TEST_ASSERT_EQ(cache.mutation_epoch, epoch);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 8, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[8], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    uint32_t resident = find_resident(&cache, 8);
+    TEST_ASSERT(resident < cache.num_slots);
+    TEST_ASSERT(!cache.slots[resident].dirty);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 8, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[8], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    TEST_ASSERT_EQ(cache.mutation_epoch, epoch);
+    bfs_cache_destroy(&cache);
+}
+
+static void test_cursor_boundary_misses_do_not_count_or_qualify(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 7, result, false), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 1);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+    TEST_ASSERT_EQ(find_resident(&cache, 7), cache.num_slots);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 7, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, 7), cache.num_slots);
+
+    /* A boundary-only revisit does not use the existing ghost as evidence. */
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 7, result, false), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 3);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, 7), cache.num_slots);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 7, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 4);
+    TEST_ASSERT(find_resident(&cache, 7) < cache.num_slots);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 7, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 4);
+    bfs_cache_destroy(&cache);
+}
+
+static void test_demand_read_admits_and_forgets_scan_ghost(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+    uint64_t epoch = cache.mutation_epoch;
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 9, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, 9), cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost[0], 9);
+
+    TEST_ASSERT_EQ(bfs_bio_read(&cache.bio, 9, result), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[9], BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    TEST_ASSERT(find_resident(&cache, 9) < cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost[0], UINT32_MAX);
+    TEST_ASSERT_EQ(cache.mutation_epoch, epoch);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 9, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    bfs_cache_destroy(&cache);
+}
+
+static void test_read_errors_do_not_record_reuse(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    memory.fail_read = true;
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 11, result, true), BFS_ERR_IO);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+    TEST_ASSERT_EQ(find_resident(&cache, 11), cache.num_slots);
+
+    memory.fail_read = false;
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 11, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 2);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, 11), cache.num_slots);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 11, result, true), BFS_OK);
+    TEST_ASSERT_EQ(memory.reads, 3);
+    TEST_ASSERT(find_resident(&cache, 11) < cache.num_slots);
+    bfs_cache_destroy(&cache);
+}
