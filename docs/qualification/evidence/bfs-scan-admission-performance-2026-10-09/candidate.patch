+    TEST_RUN(test_scan_misses_require_two_reuses_then_hit);
+    TEST_RUN(test_cursor_boundary_misses_do_not_count_or_qualify);
+    TEST_RUN(test_demand_read_admits_and_forgets_scan_ghost);
+    TEST_RUN(test_read_errors_do_not_record_reuse);
+    TEST_RUN(test_dirty_hits_are_visible_and_all_dirty_misses_stay_uncached);
+    TEST_RUN(test_mutations_and_invalidation_clear_history_and_advance_epoch);
+    TEST_RUN(test_stream_longer_than_ghost_history);
+    TEST_RUN(test_directory_cursor_resume_marks_consumed_leaf_non_reusable);
+    TEST_RUN(test_directory_scan_opt_out_uses_demand_admission);
+    TEST_RUN(test_directory_scan_admission_and_miss_validation);
+TEST_SUITE_END()
