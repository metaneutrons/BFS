+static void test_dirty_hits_are_visible_and_all_dirty_misses_stay_uncached(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t image[BLOCK_SIZE];
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+    bfs_cache_set_deferred_node_limit(&cache, 1);
+
+    memset(image, 0xA1, sizeof(image));
+    TEST_ASSERT_EQ(bfs_bio_defer_node(&cache.bio, 1, image, finish_node, NULL), BFS_OK);
+    uint32_t dirty_slot = find_resident(&cache, 1);
+    TEST_ASSERT(dirty_slot < cache.num_slots);
+    TEST_ASSERT(cache.slots[dirty_slot].dirty);
+    uint32_t previous_age = cache.slots[dirty_slot].age;
+    uint32_t reads_before_hit = memory.reads;
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 1, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, image, BLOCK_SIZE);
+    TEST_ASSERT_EQ(memory.reads, reads_before_hit);
+    TEST_ASSERT(cache.slots[dirty_slot].age > previous_age);
+
+    /* The second dirty image attempts an early write; failing that write must
+     * not make either dirty slot available to a scan miss. */
+    memory.fail_write = true;
+    memset(image, 0xB2, sizeof(image));
+    TEST_ASSERT_EQ(bfs_bio_defer_node(&cache.bio, 2, image, finish_node, NULL), BFS_OK);
+    TEST_ASSERT_EQ(cache.dirty_count, 2);
+    TEST_ASSERT(cache.slots[find_resident(&cache, 1)].dirty);
+    TEST_ASSERT(cache.slots[find_resident(&cache, 2)].dirty);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 3, result, true), BFS_OK);
+    TEST_ASSERT_MEM_EQ(result, memory.blocks[3], BLOCK_SIZE);
+    TEST_ASSERT_EQ(find_resident(&cache, 3), cache.num_slots);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 3, result, true), BFS_OK);
+    TEST_ASSERT_EQ(find_resident(&cache, 3), cache.num_slots);
+    TEST_ASSERT_EQ(cache.dirty_count, 2);
+    TEST_ASSERT(cache.slots[find_resident(&cache, 1)].dirty);
+    TEST_ASSERT(cache.slots[find_resident(&cache, 2)].dirty);
+    bfs_cache_destroy(&cache);
+}
+
+static void test_mutations_and_invalidation_clear_history_and_advance_epoch(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    uint8_t replacement[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+    uint64_t epoch;
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &epoch));
+    TEST_ASSERT_EQ(epoch, 0);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 4, result, true), BFS_OK);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    uint64_t after_scan;
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &after_scan));
+    TEST_ASSERT_EQ(after_scan, epoch);
+
+    memset(replacement, 0xC3, sizeof(replacement));
+    TEST_ASSERT_EQ(bfs_bio_write(&cache.bio, 20, replacement), BFS_OK);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &epoch));
+    TEST_ASSERT_EQ(epoch, after_scan + 1);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 4, result, true), BFS_OK);
+    TEST_ASSERT_EQ(find_resident(&cache, 4), cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 1);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 4, result, true), BFS_OK);
+    TEST_ASSERT(find_resident(&cache, 4) < cache.num_slots);
+
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 5, result, true), BFS_OK);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 2);
+    TEST_ASSERT_EQ(cache.scan_ghost[0], UINT32_MAX);
+    TEST_ASSERT_EQ(cache.scan_ghost[1], 5);
+    bfs_cache_invalidate(&cache);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &epoch));
+    TEST_ASSERT_EQ(epoch, after_scan + 2);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 5, result, true), BFS_OK);
+    TEST_ASSERT_EQ(find_resident(&cache, 5), cache.num_slots);
+
+    memory.fail_write = true;
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 6, result, true), BFS_OK);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 2);
+    TEST_ASSERT_EQ(bfs_bio_write(&cache.bio, 21, replacement), BFS_ERR_IO);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&cache.bio, &after_scan));
+    TEST_ASSERT_EQ(after_scan, epoch + 1);
+    bfs_cache_destroy(&cache);
+}
+
+static void test_stream_longer_than_ghost_history(void)
+{
+    scan_memory_bio_t memory;
+    bfs_cache_t cache;
+    uint8_t result[BLOCK_SIZE];
+    scan_memory_init(&memory);
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory.bio, 2), BFS_OK);
+
+    for (bfs_blk_t block = 0; block < 4; block++) {
+        TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, block, result, true), BFS_OK);
+        TEST_ASSERT_EQ(find_resident(&cache, block), cache.num_slots);
+    }
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 2);
+
+    /* Block 0 aged out of the two-entry history; block 3 remains eligible. */
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 0, result, true), BFS_OK);
+    TEST_ASSERT_EQ(find_resident(&cache, 0), cache.num_slots);
+    TEST_ASSERT_EQ(bfs_bio_read_scan_leaf(&cache.bio, 3, result, true), BFS_OK);
+    TEST_ASSERT(find_resident(&cache, 3) < cache.num_slots);
+    bfs_cache_destroy(&cache);
+}
+
+typedef struct {
+    bfs_allocator_t iface;
+    bfs_blk_t next;
+} scan_allocator_t;
+
+static bfs_blk_t scan_alloc(bfs_allocator_t *allocator)
+{
+    scan_allocator_t *scan_allocator = allocator->ctx;
+    if (scan_allocator->next >= BLOCK_COUNT) return BFS_BLK_NULL;
+    return scan_allocator->next++;
+}
+
+static bfs_err_t scan_dealloc(bfs_allocator_t *allocator, bfs_blk_t block)
+{
+    (void)allocator;
+    (void)block;
+    return BFS_OK;
+}
+
+static bool count_directory_entry(const char *name, uint8_t name_len,
+                                  uint32_t inode, uint32_t type, void *context)
+{
+    (void)name;
+    (void)name_len;
+    (void)inode;
+    (void)type;
+    (*(uint32_t *)context)++;
+    return true;
+}
+
+typedef struct {
+    const bfs_bio_ops_t *base_ops;
+    uint32_t record_reuse_true;
+    uint32_t record_reuse_false;
+} scan_dispatch_trace_t;
+
+static scan_dispatch_trace_t *active_scan_trace;
+
+static bfs_err_t trace_read_scan_leaf(bfs_bio_t *bio, bfs_blk_t block,
+                                      void *buffer, bool record_reuse)
+{
+    if (record_reuse)
+        active_scan_trace->record_reuse_true++;
+    else
+        active_scan_trace->record_reuse_false++;
+    return active_scan_trace->base_ops->read_scan_leaf(bio, block, buffer,
+                                                        record_reuse);
+}
+
+static void install_scan_dispatch_trace(bfs_cache_t *cache,
+                                        scan_dispatch_trace_t *trace,
+                                        bfs_bio_ops_t *traced_ops)
+{
+    trace->base_ops = cache->bio.ops;
+    trace->record_reuse_true = 0;
+    trace->record_reuse_false = 0;
+    *traced_ops = *trace->base_ops;
+    traced_ops->read_scan_leaf = trace_read_scan_leaf;
+    active_scan_trace = trace;
+    cache->bio.ops = traced_ops;
+}
+
+static void remove_scan_dispatch_trace(bfs_cache_t *cache,
+                                       const scan_dispatch_trace_t *trace)
+{
+    cache->bio.ops = trace->base_ops;
+    active_scan_trace = NULL;
+}
+
+static bool make_two_entry_directory(scan_memory_bio_t *memory,
+                                     bfs_cache_t *cache,
+                                     scan_allocator_t *allocator,
+                                     bfs_dir_tree_t *directory,
+                                     uint32_t cache_slots)
+{
+    scan_memory_init(memory);
+    if (bfs_cache_init(cache, &memory->bio, cache_slots) != BFS_OK)
+        return false;
+    memset(allocator, 0, sizeof(*allocator));
+    allocator->iface.alloc = scan_alloc;
+    allocator->iface.dealloc = scan_dealloc;
+    allocator->iface.ctx = allocator;
+    allocator->next = 2;
+    if (bfs_dir_init(directory, &cache->bio, &allocator->iface,
+                     BFS_BLK_NULL, 1) != BFS_OK)
+        return false;
+    if (bfs_dir_insert(directory, 5, "alpha", 5, 100, BFS_INODE_FILE) != BFS_OK)
+        return false;
+    if (bfs_dir_insert(directory, 5, "beta", 4, 101, BFS_INODE_FILE) != BFS_OK)
+        return false;
+    return directory->tree.height == 1;
+}
+
+typedef struct {
+    uint32_t calls;
+    uint32_t stop_after;
+} stop_directory_scan_t;
+
+static bool stop_directory_scan_on_nth(const char *name, uint8_t name_len,
+                                        uint32_t inode, uint32_t type,
+                                        void *context)
+{
+    stop_directory_scan_t *scan = context;
+    (void)name;
+    (void)name_len;
+    (void)inode;
+    (void)type;
+    scan->calls++;
+    return scan->calls < scan->stop_after;
+}
+
+static void test_directory_cursor_resume_marks_consumed_leaf_non_reusable(void)
+{
+    scan_memory_bio_t *memory = calloc(1, sizeof(*memory));
+    TEST_ASSERT(memory != NULL);
+    bfs_cache_t cache;
+    scan_allocator_t allocator;
+    bfs_dir_tree_t directory;
+    TEST_ASSERT(make_two_entry_directory(memory, &cache, &allocator,
+                                         &directory, 1));
+    bfs_cache_invalidate(&cache);
+    memory->reads = 0;
+
+    scan_dispatch_trace_t trace;
+    bfs_bio_ops_t traced_ops;
+    install_scan_dispatch_trace(&cache, &trace, &traced_ops);
+    bfs_btree_cursor_t cursor = {0};
+    stop_directory_scan_t stop = {.stop_after = 2};
+    TEST_ASSERT_EQ(bfs_dir_scan_cursor(&directory, &cursor, 5, NULL, 0,
+                                       stop_directory_scan_on_nth, &stop), BFS_OK);
+    TEST_ASSERT_EQ(stop.calls, 2);
+    TEST_ASSERT(cursor.stopped);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 1);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 0);
+    TEST_ASSERT_EQ(memory->reads, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, directory.tree.root), cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost[0], directory.tree.root);
+
+    uint32_t resumed_calls = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan_resume(&directory, &cursor, 5,
+                                       count_directory_entry, &resumed_calls), BFS_OK);
+    TEST_ASSERT_EQ(resumed_calls, 0);
+    TEST_ASSERT(!cursor.stopped);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 1);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 1);
+    TEST_ASSERT_EQ(memory->reads, 2);
+    TEST_ASSERT_EQ(find_resident(&cache, directory.tree.root), cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost[0], directory.tree.root);
+
+    uint32_t count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 2);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 1);
+    TEST_ASSERT_EQ(memory->reads, 3);
+    TEST_ASSERT(find_resident(&cache, directory.tree.root) < cache.num_slots);
+
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(memory->reads, 3);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 2);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 1);
+
+    remove_scan_dispatch_trace(&cache, &trace);
+    bfs_cache_destroy(&cache);
+    free(cursor.leaf);
+    free(memory);
+}
+
+static void test_directory_scan_opt_out_uses_demand_admission(void)
+{
+    scan_memory_bio_t *memory = calloc(1, sizeof(*memory));
+    TEST_ASSERT(memory != NULL);
+    bfs_cache_t cache;
+    scan_allocator_t allocator;
+    bfs_dir_tree_t directory;
+    TEST_ASSERT(make_two_entry_directory(memory, &cache, &allocator,
+                                         &directory, 1));
+    bfs_cache_invalidate(&cache);
+    memory->reads = 0;
+
+    bfs_btree_ops_t no_scan_admission = *directory.tree.ops;
+    no_scan_admission.scan_admission = false;
+    directory.tree.ops = &no_scan_admission;
+    scan_dispatch_trace_t trace;
+    bfs_bio_ops_t traced_ops;
+    install_scan_dispatch_trace(&cache, &trace, &traced_ops);
+
+    uint32_t count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 0);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 0);
+    TEST_ASSERT_EQ(memory->reads, 1);
+    TEST_ASSERT(find_resident(&cache, directory.tree.root) < cache.num_slots);
+    TEST_ASSERT_EQ(cache.scan_ghost_count, 0);
+
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(memory->reads, 1);
+    TEST_ASSERT_EQ(trace.record_reuse_true, 0);
+    TEST_ASSERT_EQ(trace.record_reuse_false, 0);
+
+    remove_scan_dispatch_trace(&cache, &trace);
+    bfs_cache_destroy(&cache);
+    free(memory);
+}
+
+static void test_directory_scan_admission_and_miss_validation(void)
+{
+    scan_memory_bio_t *memory = calloc(1, sizeof(*memory));
+    TEST_ASSERT(memory != NULL);
+    scan_memory_init(memory);
+    bfs_cache_t cache;
+    TEST_ASSERT_EQ(bfs_cache_init(&cache, &memory->bio, 1), BFS_OK);
+
+    scan_allocator_t allocator = {0};
+    allocator.iface.alloc = scan_alloc;
+    allocator.iface.dealloc = scan_dealloc;
+    allocator.iface.ctx = &allocator;
+    allocator.next = 2;
+    bfs_dir_tree_t directory;
+    TEST_ASSERT_EQ(bfs_dir_init(&directory, &cache.bio, &allocator.iface,
+                                BFS_BLK_NULL, 1), BFS_OK);
+    TEST_ASSERT_EQ(bfs_dir_insert(&directory, 5, "alpha", 5, 100,
+                                  BFS_INODE_FILE), BFS_OK);
+    TEST_ASSERT_EQ(bfs_dir_insert(&directory, 5, "beta", 4, 101,
+                                  BFS_INODE_FILE), BFS_OK);
+    TEST_ASSERT_EQ(directory.tree.height, 1);
+
+    bfs_cache_invalidate(&cache);
+    memory->reads = 0;
+    uint32_t count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(memory->reads, 1);
+    TEST_ASSERT_EQ(find_resident(&cache, directory.tree.root), cache.num_slots);
+
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(memory->reads, 2);
+    uint32_t resident = find_resident(&cache, directory.tree.root);
+    TEST_ASSERT(resident < cache.num_slots);
+    TEST_ASSERT(cache.slots[resident].node_structure_valid);
+
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count), BFS_OK);
+    TEST_ASSERT_EQ(count, 2);
+    TEST_ASSERT_EQ(memory->reads, 2);
+
+    /* Make a semantically invalid directory leaf with a valid CRC, then force
+     * a cache miss. The scan must validate the whole leaf before its callback. */
+    bfs_cache_invalidate(&cache);
+    uint8_t *image = memory->blocks[directory.tree.root];
+    TEST_ASSERT(num_keys(image) >= 1);
+    bfs_dir_val_t *value = (bfs_dir_val_t *)leaf_val(&directory.tree, image, 0);
+    value->entry_type = bfs_be32(UINT32_MAX);
+    hdr_of(image)->crc32 = bfs_be32(node_compute_crc(&directory.tree, image));
+    uint32_t reads_before_corrupt_scan = memory->reads;
+
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count),
+                   BFS_ERR_CORRUPT);
+    TEST_ASSERT_EQ(count, 0);
+    TEST_ASSERT_EQ(memory->reads, reads_before_corrupt_scan + 1);
+    TEST_ASSERT_EQ(find_resident(&cache, directory.tree.root), cache.num_slots);
+
+    /* The miss that qualifies for admission still performs the same checks. */
+    count = 0;
+    TEST_ASSERT_EQ(bfs_dir_scan(&directory, 5, count_directory_entry, &count),
+                   BFS_ERR_CORRUPT);
+    TEST_ASSERT_EQ(count, 0);
+    TEST_ASSERT_EQ(memory->reads, reads_before_corrupt_scan + 2);
+    resident = find_resident(&cache, directory.tree.root);
+    TEST_ASSERT(resident < cache.num_slots);
+    TEST_ASSERT(!cache.slots[resident].node_crc_valid);
+    TEST_ASSERT(!cache.slots[resident].node_structure_valid);
+
+    bfs_cache_destroy(&cache);
+    free(memory);
+}
