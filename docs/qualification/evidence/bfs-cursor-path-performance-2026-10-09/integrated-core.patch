+    if (!bfs_btree_cursor_stop_key(tree, cursor)) return BFS_ERR_AGAIN;
+    if (!tree_shape_valid(tree)) return BFS_ERR_CORRUPT;
+    return btree_scan_cursor_impl(tree, cursor, NULL, true, cb, ctx);
+}
