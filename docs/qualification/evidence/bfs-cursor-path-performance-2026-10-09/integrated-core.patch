+/* This location cache is deliberately narrower than the general B-tree
+ * validation cache. It is enabled only for canonical big-endian u32 keys and
+ * only when the BIO can return a freshly validated resident node. */
+static bool key_hint_cache_eligible(const bfs_btree_t *tree)
+{
+    return tree->key_hint_cache && tree->ops->cache_key_order &&
+           tree->ops->key_compare == bfs_btree_key_compare_be32 &&
+           tree->ops->key_size == sizeof(uint32_t) &&
+           tree->bio->ops->peek_valid_node;
+}
+
+static uint32_t key_hint_slot(uint32_t key)
+{
+    return (key * 2654435761u) >> 26;
+}
+
+static bool key_hint_read(const bfs_btree_t *tree, const void *key,
+                          void *val_out, uint64_t mutation_epoch)
+{
+    if (!key_hint_cache_eligible(tree)) return false;
+
+    uint32_t key_value = bfs_load_be32(key);
+    const bfs_btree_key_hint_t *hint =
+        &tree->key_hint_cache->slots[key_hint_slot(key_value)];
+    if (hint->leaf == BFS_BLK_NULL || hint->key != key_value ||
+        hint->root != tree->root || hint->generation != tree->generation ||
+        hint->mutation_epoch != mutation_epoch ||
+        hint->leaf >= tree->bio->block_count)
+        return false;
+
+    bfs_node_validation_t validation = node_validation_context(tree);
+    const uint8_t *leaf = bfs_bio_peek_valid_node(tree->bio, hint->leaf,
+                                                   &validation);
+    if (!leaf || node_level((uint8_t *)leaf) != BFS_BTNODE_LEAF ||
+        hint->index >= num_keys((uint8_t *)leaf) ||
+        tree->ops->key_compare(node_key(tree, (uint8_t *)leaf, hint->index),
+                               key) != 0)
+        return false;
+
+    /* peek_valid_node's pointer is valid only until the next BIO call. Copy
+     * the current value immediately; the cache stores no inode/value bytes. */
+    memcpy(val_out, leaf_val(tree, (uint8_t *)leaf, hint->index),
+           tree->ops->val_size); /* Flawfinder: ignore */ // nosemgrep: c_buffer_rule-memcpy-CopyMemory
+    return true;
+}
+
+static void key_hint_remember(bfs_btree_t *tree, const void *key,
+                             bfs_blk_t leaf, uint32_t index,
+                             uint64_t mutation_epoch)
+{
+    if (!key_hint_cache_eligible(tree)) return;
+
+    uint32_t key_value = bfs_load_be32(key);
+    bfs_btree_key_hint_t *hint =
+        &tree->key_hint_cache->slots[key_hint_slot(key_value)];
+    hint->key = key_value;
+    hint->leaf = leaf;
+    hint->index = index;
+    hint->generation = tree->generation;
+    hint->root = tree->root;
+    hint->mutation_epoch = mutation_epoch;
+}
