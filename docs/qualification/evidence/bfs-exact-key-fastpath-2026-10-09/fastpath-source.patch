+static void test_exact_hit_bypasses_range_preparation_but_miss_prepares(void)
+{
+    hint_fixture_t fixture;
+    TEST_ASSERT(fixture_open(&fixture, 0));
+    probe_install(&fixture);
+
+    /* Seed a current exact slot and a range table for the root inode. */
+    bfs_btree_key_hint_cache_reset(&fixture.fs->inode_key_hints);
+    fixture.fs->inode_tree.hint_leaf = BFS_BLK_NULL;
+    fixture.fs->inode_tree.hint_root = BFS_BLK_NULL;
+    fixture.fs->inode_tree.hint_generation = 0;
+    fixture.fs->inode_tree.hint_mutation_epoch = 0;
+    bfs_inode_t inode;
+    TEST_ASSERT_EQ(bfs_inode_read(&fixture.fs->inode_tree, BFS_ROOT_INO,
+                                  &inode), BFS_OK);
+    TEST_ASSERT(probe_alloc_calls > 0);
+
+    bfs_btree_key_hint_cache_t *cache = &fixture.fs->inode_key_hints;
+    bfs_btree_key_hint_t *exact = find_hint(cache, BFS_ROOT_INO);
+    TEST_ASSERT(exact != NULL);
+    TEST_ASSERT(cache->leaf_count > 0);
+    uint64_t epoch = 0;
+    TEST_ASSERT(bfs_bio_get_mutation_epoch(&fixture.cache.bio, &epoch));
+    TEST_ASSERT_EQ(exact->mutation_epoch, epoch);
+
+    /* These are range-table guards only. Keep the exact slot's tree, root,
+     * generation, and BIO epoch valid, but make range preparation necessary. */
+    cache->leaf_mutation_epoch = epoch ^ 1u;
+    cache->leaf_count = BFS_BTREE_LEAF_HINT_SLOTS + 1u;
+    uint16_t stale_count = cache->leaf_count;
+    uint16_t stale_victim = cache->leaf_next_victim;
+    bfs_blk_t stale_root = cache->leaf_root;
+    uint32_t stale_generation = cache->leaf_generation;
+    uint64_t stale_epoch = cache->leaf_mutation_epoch;
+    bfs_btree_leaf_hint_t stale_routes[BFS_BTREE_LEAF_HINT_SLOTS];
+    memcpy(stale_routes, cache->leaf_slots, sizeof(stale_routes));
+
+    /* With the unrelated last-leaf route disabled, a successful allocation-
+     * free read proves the exact slot served the lookup before range prep. */
+    fixture.fs->inode_tree.hint_leaf = BFS_BLK_NULL;
+    probe_alloc_calls = 0;
+    TEST_ASSERT_EQ(bfs_inode_read(&fixture.fs->inode_tree, BFS_ROOT_INO,
+                                  &inode), BFS_OK);
+    TEST_ASSERT_EQ(bfs_be32(inode.inode_nr), BFS_ROOT_INO);
+    TEST_ASSERT_EQ(probe_alloc_calls, 0);
+    TEST_ASSERT_EQ(cache->leaf_count, stale_count);
+    TEST_ASSERT_EQ(cache->leaf_next_victim, stale_victim);
+    TEST_ASSERT_EQ(cache->leaf_root, stale_root);
+    TEST_ASSERT_EQ(cache->leaf_generation, stale_generation);
+    TEST_ASSERT_EQ(cache->leaf_mutation_epoch, stale_epoch);
+    TEST_ASSERT_EQ(cache->leaf_owner, &fixture.fs->inode_tree);
+    TEST_ASSERT_EQ(cache->leaf_bio, &fixture.cache.bio);
+    TEST_ASSERT_EQ(cache->leaf_ops, fixture.fs->inode_tree.ops);
+    TEST_ASSERT(memcmp(cache->leaf_slots, stale_routes,
+                       sizeof(stale_routes)) == 0);
+
+    /* An exact miss still runs normal preparation and repairs stale range
+     * metadata before falling through to the B-tree traversal. */
+    fixture.fs->inode_tree.hint_leaf = BFS_BLK_NULL;
+    probe_alloc_calls = 0;
+    TEST_ASSERT_EQ(bfs_inode_read(&fixture.fs->inode_tree, 0x7FFFFFFFu,
+                                  &inode), BFS_ERR_NOTFOUND);
+    TEST_ASSERT(probe_alloc_calls > 0);
+    TEST_ASSERT_EQ(cache->leaf_count, 0);
+    TEST_ASSERT_EQ(cache->leaf_next_victim, 0);
+    TEST_ASSERT_EQ(cache->leaf_root, fixture.fs->inode_tree.root);
+    TEST_ASSERT_EQ(cache->leaf_generation, fixture.fs->inode_tree.generation);
+    TEST_ASSERT_EQ(cache->leaf_mutation_epoch, epoch);
+
+    fixture_close(&fixture);
+}
