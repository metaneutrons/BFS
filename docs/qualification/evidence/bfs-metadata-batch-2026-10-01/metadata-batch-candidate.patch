+    uint64_t root_txn;
+    bfs_err_t err = bfs_btree_root_leaf_txn_id(&fs->tree, &root_txn);
+    if (err != BFS_OK) return err;
+    if (root_txn > live) return BFS_ERR_CORRUPT;
+    /* A forged live tag cannot authorize retirement of a published block.
+     * Refill would otherwise mask the tag and recycle that block in_alloc. */
+    if (root_txn == live &&
+        seal_block_is_sb_root(&owner->txn.sb, fs->tree.root))
+        return BFS_ERR_CORRUPT;
+    bool root_is_current = root_txn == live;
+
+    seal_geometry_t geometry = seal_geometry(owner);
+    err = validate_metadata_batch_stock(fs, owner, &geometry);
+    if (err != BFS_OK) return err;
+
+    uint32_t capacity = bfs_btree_leaf_capacity(&fs->tree);
+    if (capacity == 0 ||
+        (uint64_t)capacity * 2u * sizeof(uint32_t) > SIZE_MAX)
+        return capacity == 0 ? BFS_ERR_CORRUPT : BFS_ERR_NOMEM;
+    uint32_t *storage = malloc((size_t)capacity * 2u * sizeof(*storage));
+    if (!storage) return BFS_ERR_NOMEM;
+    free_leaf_entries_t leaf = {
+        .keys = storage, .lengths = storage + capacity,
+        .capacity = capacity, .block_count = fs->tree.bio->block_count,
+        .error = BFS_OK,
+    };
+    err = bfs_btree_scan(&fs->tree, NULL, collect_free_leaf_entry, &leaf);
+    if (err == BFS_OK) err = leaf.error;
+    if (err == BFS_OK) err = validate_seal_old_leaf(owner, &leaf, &geometry);
+    if (err == BFS_OK) err = validate_free_leaf_pool_separation(fs, &leaf);
+    if (err != BFS_OK) {
+        free(storage);
+        return err;
+    }
+
+    /* A tail can consume its complete extent and require a delete rather
+     * than an update. Budget the shared delete preflight for every tail,
+     * plus the one slot retired by an initial older root. This read-only
+     * callback is owner-bound; low headroom declines before optional writes
+     * so the ordinary smaller allocation remains available. */
+    uint32_t pending_budget = BFS_BTREE_DELETE_FREE_BUDGET(fs->tree.height) +
+        (root_is_current ? 0u : 1u);
+    if (fs->tree.free_sink.headroom(owner) < pending_budget) {
+        free(storage);
+        return BFS_ERR_UNSUPPORTED;
+    }
+
+    uint32_t original_emergency_count = bfs_be32(fs->sb->emergency_count);
+    if (fs->global_reserve == UINT32_MAX ||
+        (fs->reserve_count == 0 && original_emergency_count == 0)) {
+        free(storage);
+        return BFS_ERR_UNSUPPORTED;
+    }
+    uint32_t reserve_headroom = BFS_ALLOC_RESERVE_SIZE - floor;
+    /* If a current root is the only available recursion scratch, replacing
+     * it returns that block during the first COW. Leave one reserve slot for
+     * this normal in-allocation retirement before appending the tail draw. */
+    if (root_is_current && fs->reserve_count == 0 && reserve_headroom > 0)
+        reserve_headroom--;
+    uint32_t max_extra = reserve_headroom;
+    if (max_extra > 8u) max_extra = 8u;
+    uint64_t available = fs->total_free > (uint64_t)fs->global_reserve + 1
+        ? (uint64_t)fs->total_free - fs->global_reserve - 1 : 0;
+    uint64_t missing_prefix = floor - fs->reserve_count;
+    bool stale_root_reserve_scratch = !root_is_current &&
+                                      fs->reserve_count > 0;
+    uint64_t scratch_loss = stale_root_reserve_scratch ? 1 : 0;
+    if (available <= missing_prefix + scratch_loss) {
+        free(storage);
+        return BFS_ERR_UNSUPPORTED;
+    }
+    uint64_t available_extra = available - missing_prefix - scratch_loss;
+    if ((uint64_t)max_extra > available_extra)
+        max_extra = (uint32_t)available_extra;
+    if (max_extra < 2u) {
+        free(storage);
+        return BFS_ERR_UNSUPPORTED;
+    }
+    uint32_t extra = max_extra;
+    metadata_refill_plan_t plan = {
+        .target = floor + extra,
+        .emergency_count = original_emergency_count -
+            (fs->reserve_count == 0 ? 1u : 0u),
+        .min_blocks_withdrawn = floor + extra - fs->reserve_count -
+            (root_is_current && fs->reserve_count == 0 ? 1u : 0u),
+        .max_blocks_withdrawn = floor + extra - fs->reserve_count +
+            scratch_loss,
+    };
+
+    bfs_blk_t old_root = fs->tree.root;
+    uint32_t old_total_free = fs->total_free;
+    bfs_blk_t original_reserve[BFS_ALLOC_RESERVE_SIZE];
+    uint32_t original_emergency_pool[BFS_EMERGENCY_POOL_SIZE];
+    uint32_t original_reserve_count = fs->reserve_count;
+    bfs_blk_t original_roving = fs->roving;
+    memcpy(original_reserve, fs->reserve, sizeof(original_reserve));
+    memcpy(original_emergency_pool, fs->sb->emergency_pool,
+           sizeof(original_emergency_pool));
+
+    *started = true;
+    err = freespace_refill_to_target(fs, plan.target);
+    if (err != BFS_OK) {
+        metadata_batch_latch_uncertain(fs, owner, old_root,
+            old_total_free, original_roving,
+            original_reserve, original_reserve_count,
+            original_emergency_pool, original_emergency_count, err);
+        free(storage);
+        return err;
+    }
+
+    uint64_t blocks_withdrawn = old_total_free >= fs->total_free
+        ? (uint64_t)old_total_free - fs->total_free : UINT64_MAX;
+    uint32_t max_reserve = plan.target +
+        (root_is_current && original_reserve_count == 0 ? 1u : 0u);
+    bool accounting_ok = fs->reserve_count >= plan.target &&
+        fs->reserve_count <= max_reserve &&
+        blocks_withdrawn >= plan.min_blocks_withdrawn &&
+        blocks_withdrawn <= plan.max_blocks_withdrawn &&
+        bfs_be32(fs->sb->emergency_count) == plan.emergency_count;
+    uint64_t post_root_txn = 0;
+    err = bfs_btree_root_leaf_txn_id(&fs->tree, &post_root_txn);
+    if (err == BFS_OK && (post_root_txn != live ||
+        seal_block_is_sb_root(&owner->txn.sb, fs->tree.root)))
+        err = BFS_ERR_CORRUPT;
+    if (err == BFS_OK && !accounting_ok) err = BFS_ERR_CORRUPT;
+    if (err != BFS_OK) {
+        metadata_batch_latch_uncertain(fs, owner, old_root,
+            old_total_free, original_roving,
+            original_reserve, original_reserve_count,
+            original_emergency_pool, original_emergency_count, err);
+        free(storage);
+        return err;
+    }
+
+    bfs_err_t post_owner_err = allocator_owner_error(fs);
+    if (post_owner_err != BFS_OK ||
+        !metadata_batch_context_available(fs, owner)) {
+        err = post_owner_err != BFS_OK ? post_owner_err : BFS_ERR_CORRUPT;
+        metadata_batch_latch_uncertain(fs, owner, old_root,
+            old_total_free, original_roving,
+            original_reserve, original_reserve_count,
+            original_emergency_pool, original_emergency_count, err);
+        free(storage);
+        return err;
+    }
+
+    bfs_blk_t spare = BFS_BLK_NULL;
+    err = pop_metadata_spare(fs, floor, &spare, owner);
+    if (err == BFS_ERR_UNSUPPORTED) err = BFS_ERR_CORRUPT;
+    if (err == BFS_OK && (spare == BFS_BLK_NULL ||
+                           fs->reserve_count < floor + 1u ||
+                           fs->reserve_count > max_reserve - 1))
+        err = BFS_ERR_CORRUPT;
+    if (err != BFS_OK) {
+        metadata_batch_latch_uncertain(fs, owner, old_root,
+            old_total_free, original_roving,
+            original_reserve, original_reserve_count,
+            original_emergency_pool, original_emergency_count, err);
+        free(storage);
+        return err;
+    }
+
+    fs->metadata_batch_txn = live;
+    fs->roving = original_roving;
+    *out = spare;
+    free(storage);
+    return BFS_OK;
+}
+
