+bfs_err_t bfs_file_proto_flush(bfs_file_t *f)
+{
+    bfs_lock_write(&f->fs->lock);
+    bfs_err_t err = BFS_OK;
+    if (f->proto_dirty) {
+        err = bfs_inode_write(f->inode_tree, f->inode_nr, &f->proto_inode);
+        if (err == BFS_OK) f->proto_dirty = false;
+    }
+    bfs_lock_unlock(&f->fs->lock);
+    return err;
+}
