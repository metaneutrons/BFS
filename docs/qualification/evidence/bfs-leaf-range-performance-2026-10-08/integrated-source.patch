+/* Save the directory's ExNext order as compact indices. ExAll has no
+ * ordering promise of its own; this gives the mixed-call oracle one exact
+ * reference sequence for both APIs. */
+static BOOL exallpack_item_number(const char *name, UBYTE *number)
+{
+    return item_number(name, 40, number);
+}
+
+static BOOL exallpack_collect_order(BPTR lock, struct FileInfoBlock *fib,
+                                    UBYTE order[40])
+{
+    UBYTE seen[40] = {0};
+    ULONG count = 0;
+    if (!Examine(lock, fib)) return FALSE;
+    while (ExNext(lock, fib)) {
+        UBYTE number;
+        if (count >= 40 || !exallpack_item_number(fib->fib_FileName, &number) ||
+            seen[number]) return FALSE;
+        seen[number] = 1;
+        order[count++] = number;
+    }
+    return IoErr() == ERROR_NO_MORE_ENTRIES && count == 40 && all_seen(seen, 40);
+}
+
+static BOOL exallpack_consume_number(UBYTE number, const UBYTE order[40],
+                                    UBYTE seen[40], ULONG *position)
+{
+    if (*position >= 40 || order[*position] != number || seen[number]) return FALSE;
+    seen[number] = 1;
+    (*position)++;
+    return TRUE;
+}
+
+/* Validate one packed ED_COMMENT batch, including pointer bounds before
+ * following the variable-length list. */
+static BOOL exallpack_check_batch(const UBYTE *storage, ULONG storage_size,
+                                  struct ExAllControl *control,
+                                  const UBYTE order[40], UBYTE seen[40],
+                                  ULONG *position)
+{
+    const UBYTE *end = storage + storage_size;
+    ULONG fixed_size = (ULONG)offsetof(struct ExAllData, ed_OwnerUID);
+    ULONG entries = control->eac_Entries;
+    if (*position > 40 || !entries || entries > 40 - *position) return FALSE;
+
+    struct ExAllData *entry = (struct ExAllData *)storage;
+    for (ULONG n = 0; n < entries; n++) {
+        if (!entry || (const UBYTE *)entry < storage ||
+            (const UBYTE *)entry > end - fixed_size) return FALSE;
+        const UBYTE *name = (const UBYTE *)entry->ed_Name;
+        const UBYTE *comment = (const UBYTE *)entry->ed_Comment;
+        if (!name || name < storage || name > end - 8 ||
+            !comment || comment < storage || comment >= end || comment[0] != 0 ||
+            entry->ed_Type != ST_FILE || entry->ed_Size != 0) return FALSE;
+        char bounded_name[8];
+        for (int i = 0; i < 7; i++) bounded_name[i] = (char)name[i];
+        bounded_name[7] = (char)name[7];
+        UBYTE number;
+        if (bounded_name[7] != 0 ||
+            !exallpack_item_number(bounded_name, &number) ||
+            !exallpack_consume_number(number, order, seen, position)) return FALSE;
+
+        struct ExAllData *next = entry->ed_Next;
+        if (n + 1 < entries) {
+            if (!next || (const UBYTE *)next < storage ||
+                (const UBYTE *)next > end - fixed_size) return FALSE;
+        } else if (next) {
+            return FALSE;
+        }
+        entry = next;
+    }
+    return entry == NULL && control->eac_LastKey == *position;
+}
+
+/* Preserve the original single-call packing regression alongside the mixed
+ * continuation oracle. */
+static BOOL exallpack_packed_oracle(BPTR lock, struct ExAllControl *control,
+                                    const UBYTE order[40])
+{
+    static ULONG storage[1024] EXALL_BUFFER;
+    UBYTE seen[40] = {0};
+    ULONG position = 0;
+    control->eac_MatchString = NULL;
+    control->eac_MatchFunc = NULL;
+    control->eac_LastKey = 0;
+    BOOL more = ExAll(lock, (struct ExAllData *)storage, sizeof(storage),
+                      ED_COMMENT, control);
+    LONG error = IoErr();
+    if (more) {
+        ExAllEnd(lock, (struct ExAllData *)storage, sizeof(storage),
+                 ED_COMMENT, control);
+        return FALSE;
+    }
+    return error == ERROR_NO_MORE_ENTRIES && control->eac_Entries == 40 &&
+           exallpack_check_batch((const UBYTE *)storage, sizeof(storage), control,
+                                 order, seen, &position) &&
+           position == 40 && all_seen(seen, 40);
+}
+
+/* On the same DOS lock, alternate bounded ExAll batches with ExNext. The
+ * continuation key means "entries consumed": ExNext must return the first
+ * item beyond the just-delivered ExAll batch. */
+static BOOL exallpack_mixed_oracle(BPTR lock, struct ExAllControl *control,
+                                   struct FileInfoBlock *fib,
+                                   const UBYTE order[40], UBYTE seen[40],
+                                   UBYTE *storage, ULONG storage_size,
+                                   BOOL *exall_pending)
+{
+    ULONG position = 0, batches = 0, overflow_batches = 0;
+    BOOL more;
+    if (!Examine(lock, fib) || !ExNext(lock, fib)) return FALSE;
+    UBYTE number;
+    if (!exallpack_item_number(fib->fib_FileName, &number) ||
+        !exallpack_consume_number(number, order, seen, &position) ||
+        position != 1 || (ULONG)fib->fib_DiskKey != position) return FALSE;
+
+    control->eac_MatchString = NULL;
+    control->eac_MatchFunc = NULL;
+    control->eac_LastKey = (ULONG)fib->fib_DiskKey;
+    do {
+        more = ExAll(lock, (struct ExAllData *)storage, storage_size,
+                     ED_COMMENT, control);
+        LONG error = IoErr();
+        *exall_pending = more;
+        batches++;
+        if (control->eac_Entries == 0) {
+            if (more || error != ERROR_NO_MORE_ENTRIES || position != 40 ||
+                control->eac_LastKey != 40) return FALSE;
+        } else if (!exallpack_check_batch(storage, storage_size, control,
+                                          order, seen, &position)) {
+            return FALSE;
+        }
+        if (!more) {
+            if (error != ERROR_NO_MORE_ENTRIES || position != 40) return FALSE;
+            break;
+        }
+        overflow_batches++;
+        if (position >= 40) return FALSE;
+
+        fib->fib_DiskKey = (LONG)control->eac_LastKey;
+        if (!ExNext(lock, fib)) return FALSE;
+        if (!exallpack_item_number(fib->fib_FileName, &number) ||
+            !exallpack_consume_number(number, order, seen, &position) ||
+            (ULONG)fib->fib_DiskKey != position) return FALSE;
+        control->eac_LastKey = (ULONG)fib->fib_DiskKey;
+    } while (batches <= 40);
+
+    if (more || batches <= 1 || overflow_batches == 0 || !all_seen(seen, 40))
+        return FALSE;
+    fib->fib_DiskKey = (LONG)control->eac_LastKey;
+    if (ExNext(lock, fib) || IoErr() != ERROR_NO_MORE_ENTRIES) return FALSE;
+    return TRUE;
+}
+
