+    const bfs_node_validation_t validation = {
+        .key_compare = tree->ops->key_compare,
+        .key_size = tree->ops->key_size,
+        .val_size = tree->ops->val_size,
+        .block_size = tree->bio->block_size,
+        .block_count = tree->bio->block_count,
